+ * Whether a queued webhook task targets an automation of `appId`. A task whose
+ * automation is gone or unreadable counts as this app's, so the dispatcher
+ * records why it cannot run.
+ */
+export async function webhookTaskBelongsToApp(taskId, appId) {
+    const task = await getPendingTask(taskId);
+    const payload = task ? parseWebhookTaskPayload(task) : null;
+    if (!payload)
+        return true;
+    const resource = await resourceGetByPath(payload.owner, payload.path);
+    if (!resource || resource.id !== payload.automationId)
+        return true;
+    return jobBelongsToApp(parseJobResource(resource.content).meta, appId);
+}
+/**
+ * Fail a queued webhook call that waited past AUTOMATION_WEBHOOK_MAX_TASK_AGE_MS
+ * instead of running it with an old payload, and record it in the
+ * automation's history. Returns whether this call expired it. The sweep passes
+ * the `updated_at` it read, so a row claimed since then is not expired.
+ */
+export async function expireAutomationWebhookTask(taskId, expectedUpdatedAt) {
+    const task = await getPendingTask(taskId);
+    const payload = task ? parseWebhookTaskPayload(task) : null;
+    if (!(await failOpenPendingTask(taskId, AUTOMATION_WEBHOOK_EXPIRED_MESSAGE, expectedUpdatedAt)))
+        return false;
+    if (payload) {
+        await recordAutomationFailure(payload, AUTOMATION_WEBHOOK_EXPIRED_MESSAGE, "automation_webhook_expired", { userEmail: task.ownerEmail, orgId: task.orgId });
+    }
+    return true;
+}
+/**
+ * The in-process runner for automation webhook tasks. It claims the task, so
+ * a second delivery of the same task returns `skipped`, and a task of another
+ * app that shares the database is left pending for that app's own process.
+ * Vivary #114: tracked, so a quit waits until the task row records the outcome.
+ */
+export function runAutomationWebhookTaskInProcess(taskId, options = {}) {
+    return trackBackgroundAutomationWork(runAutomationWebhookTaskOnce(taskId, options));
+}
+async function runAutomationWebhookTaskOnce(taskId, options) {
+    try {
+        if (!(await webhookTaskBelongsToApp(taskId, options.appId ?? undefined))) {
+            return "skipped";
+        }
+        // Vivary #114: a quit has begun, so the call stays queued, unclaimed,
+        // for the next launch.
+        if (isBackgroundAutomationsClosed())
+            return "skipped";
+        const task = await claimPendingTask(taskId, { dispatchOutcome: "in-process", appId: options.appId });
+        if (!task)
+            return "skipped";
+        return await runClaimedAutomationWebhookTask(task);
+    }
+    catch (error) {
+        console.error(`[automations] In-process webhook task ${taskId} failed:`, error);
+        return "failed";
+    }
+}
