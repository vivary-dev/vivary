--- /dev/null
+++ b/dist/jobs/unattended-surface.js
@@ -0,0 +1,235 @@
+/**
+ * Restricted tool surface for unattended automation runs.
+ *
+ * Scheduled, event, webhook, and Run now runs wait for exact owner approval
+ * before a declared configured MCP call. Their default tools act on this
+ * server's own data. They cannot send messages or change
+ * settings, jobs, or automations. This is an allowlist, so a tool that a later
+ * Core release adds stays out of automation runs until someone reviews it.
+ *
+ * The background runner applies `restrictActionsForUnattendedRun`. resources,
+ * chat-history, save-memory, delete-memory, manage-jobs, manage-automations,
+ * and manage-notifications also check an "automation" caller themselves, so
+ * a call that reaches them some other way gets the same limits. The three
+ * lookups, docs-search, framework-search, and source-search, rely on the run
+ * surface. On any other path, the CLI bridge's declared-name check refuses an
+ * unsafe name with its own text.
+ */
+import path from "node:path";
+import { createHash } from "node:crypto";
+import { isMcpToolAllowedForRequest } from "../mcp-client/visibility.js";
+import { getRequestContext, runWithRequestContext } from "../server/request-context.js";
+import { isUnsafeArgumentName } from "../scripts/parse-args.js";
+/** The default local tools every automation run keeps. */
+export const UNATTENDED_TOOLS = Object.freeze([
+    "resources",
+    "save-memory",
+    "delete-memory",
+    "chat-history",
+    "manage-progress",
+    "manage-notifications",
+    "manage-jobs",
+    "manage-automations",
+    "docs-search",
+    "framework-search",
+    "source-search",
+    "get-framework-context",
+]);
+/** Appended to the framework prompt of an automation run in place of the action list. */
+export const UNATTENDED_PROMPT_NOTE = "\n\nThis is an unattended automation run with only the tools attached to this request.\n" +
+    "The default tools act locally and cannot send email or messages, reach the web or other agents, or change settings, jobs, or automations. An explicitly attached configured MCP tool waits for the owner to approve each exact input. Do not promise unavailable steps.\n";
+/** Tools that an automation run may call for some actions only. */
+const PERMITTED_ACTIONS = {
+    "manage-jobs": {
+        actions: new Set(["list"]),
+        refusal: "Error: automation runs can only list recurring jobs. They cannot create, update, or delete them.",
+    },
+    "manage-automations": {
+        actions: new Set(["list", "list-events", "list-hosts"]),
+        refusal: "Error: automation runs can only list automations, events, and hosts. They cannot define, update, delete, test, or run automations.",
+    },
+};
+// Reads count too: these files can hold server headers or tokens that a run
+// could copy into memory.
+const CONFIGURATION_ACTIONS = new Set([
+    "read",
+    "effective",
+    "write",
+    "promote",
+    "delete",
+]);
+const MEMORY_TOOLS = new Set(["save-memory", "delete-memory"]);
+/**
+ * Resource paths that Core reads as configuration. The scheduler and the
+ * trigger dispatcher load automations from jobs/. Custom agent profiles under
+ * agents/ set a model and tools. Remote agent manifests under remote-agents/
+ * (and legacy agents/*.json) hold the URLs that call-agent reaches. In local
+ * file mode the workspace control files agent-native.json, mcp.config.json,
+ * and .mcp.json set the data mode and the MCP servers.
+ */
+const CONFIGURATION_PATH_PREFIXES = ["jobs/", "agents/", "remote-agents/"];
+const CONFIGURATION_FILES = new Set([
+    "agent-native.json",
+    "mcp.config.json",
+    ".mcp.json",
+]);
+/**
+ * Compare paths the way the store might match them: forward slashes, no
+ * leading slash or dot segments, and lower case because SQLite LIKE ignores
+ * ASCII case.
+ */
+function normalizeResourcePath(value) {
+    const slashed = String(value ?? "").trim().replace(/\\/g, "/");
+    return path.posix
+        .normalize(slashed)
+        .replace(/^(\.\/|\/)+/, "")
+        .toLowerCase();
+}
+export function isConfigurationResourcePath(value) {
+    const normalized = normalizeResourcePath(value);
+    return (CONFIGURATION_FILES.has(normalized) ||
+        CONFIGURATION_PATH_PREFIXES.some((prefix) => normalized.startsWith(prefix)));
+}
+/**
+ * Returns the error text for a tool call that an automation run may not
+ * make, or null when the call is allowed.
+ */
+export function unattendedToolRefusal(toolName, args) {
+    const unsafe = Object.keys(args ?? {}).find(isUnsafeArgumentName);
+    if (unsafe !== undefined) {
+        return `Error: automation runs cannot pass an argument named ${JSON.stringify(unsafe.slice(0, 80))}.`;
+    }
+    const action = args?.action;
+    const permitted = PERMITTED_ACTIONS[toolName];
+    if (permitted && !permitted.actions.has(action)) {
+        return permitted.refusal;
+    }
+    if (toolName === "resources" &&
+        CONFIGURATION_ACTIONS.has(action) &&
+        isConfigurationResourcePath(args?.path)) {
+        return `Error: automation runs cannot ${action} ${String(args.path)}. That path configures automations, agents, or connections.`;
+    }
+    // The memory scripts build memory/<name>.md from the name as given.
+    if (MEMORY_TOOLS.has(toolName)) {
+        const name = typeof args?.name === "string" ? args.name : "";
+        if (/[\\/]|\.\./.test(name) ||
+            isConfigurationResourcePath(`memory/${name}.md`)) {
+            return `Error: automation runs cannot use the memory name ${JSON.stringify(name.slice(0, 80))}.`;
+        }
+    }
+    if (toolName === "chat-history" && action === "open") {
+        return "Error: automation runs cannot open a chat in the app.";
+    }
+    return null;
+}
+/**
+ * The arguments a kept tool runs with in an automation run. A notification
+ * goes to the in-app inbox only, never to a webhook, Slack, or email channel.
+ */
+export function unattendedToolArgs(toolName, args) {
+    if (toolName === "manage-notifications" && args?.action === "send") {
+        return { ...args, channels: "inbox" };
+    }
+    return args;
+}
+/** A run that must not start. `errorCode` goes to the run history row. */
+export class UnattendedRunRefusedError extends Error {
+    errorCode;
+    constructor(message, errorCode) {
+        super(message);
+        this.name = "UnattendedRunRefusedError";
+        this.errorCode = errorCode;
+    }
+}
+/**
+ * Keep only the allowlisted tools and route each call through the refusal
+ * check. A declared MCP tool must exist in the current configured registry.
+ * Unavailable or hidden tools are refused before any model call.
+ *
+ * The background runner appends ". No delivery was confirmed." to the
+ * message, so it ends without a period.
+ */
+export function restrictActionsForUnattendedRun(actions, automation, options = {}) {
+    const mcpTools = automation?.meta?.mcpTools ?? [];
+    if (mcpTools.length > 0 && !options.mcpManager) {
+        throw new UnattendedRunRefusedError(`This automation lists MCP tools (${mcpTools.join(", ")}). Automation runs cannot call MCP tools. Nothing ran`, "automation_mcp_tools_refused");
+    }
+    const restricted = {};
+    for (const name of UNATTENDED_TOOLS) {
+        const entry = actions[name];
+        if (!entry)
+            continue;
+        restricted[name] = {
+            ...entry,
+            allowPersistentApproval: false,
+            run: async (args, context) => {
+                // Only the arguments the tool declares reach it.
+                const declared = entry.tool?.parameters?.properties ?? {};
+                const undeclared = Object.keys(args ?? {}).find((key) => !Object.hasOwn(declared, key));
+                if (undeclared !== undefined) {
+                    return `Error: automation runs cannot pass ${JSON.stringify(undeclared.slice(0, 80))}, which ${name} does not declare.`;
+                }
+                const refusal = unattendedToolRefusal(name, args);
+                if (refusal)
+                    return refusal;
+                // Vivary #109: the store records every write this call makes as the
+                // run's and holds an instruction file for the owner's review. It reads
+                // the run from the request context, so no tool argument can set or
+                // clear it.
+                return runWithRequestContext({
+                    ...getRequestContext(),
+                    automationRun: {
+                        runId: context?.runId ?? null,
+                        threadId: context?.threadId ?? null,
+                        automation: automation?.name ?? context?.automation?.triggerName ?? null,
+                    },
+                }, () => entry.run(unattendedToolArgs(name, args), {
+                    ...context,
+                    caller: "automation",
+                }));
+            },
+        };
+    }
+    for (const name of mcpTools) {
+        const entry = actions[name];
+        const manager = options.mcpManager;
+        const tool = manager?.getTool(name);
+        const config = tool && manager.getConfig()?.servers?.[tool.source];
+        if (!name.startsWith("mcp__") || !entry?.tool || entry.agentTool === false ||
+            !tool || !config || !isMcpToolAllowedForRequest(name)) {
+            throw new UnattendedRunRefusedError(`Configured automation tool ${name} is unavailable. Nothing ran`, "automation_mcp_tools_refused");
+        }
+        restricted[name] = {
+            ...entry,
+            needsApproval: true,
+            allowPersistentApproval: false,
+            // Hash in memory. Never persist connection configuration or credentials.
+            unattendedFingerprint: automationApprovalFingerprint({ config, tool: tool.raw }),
+            run: (args, context) => {
+                const currentTool = manager.getTool(name);
+                const currentConfig = currentTool && manager.getConfig()?.servers?.[currentTool.source];
+                if (!currentTool || !currentConfig || !isMcpToolAllowedForRequest(name) ||
+                    automationApprovalFingerprint({ config: currentConfig, tool: currentTool.raw }) !== restricted[name].unattendedFingerprint)
+                    throw new UnattendedRunRefusedError("The configured automation tool changed before invocation", "automation_approval_changed");
+                if (!context?.approvedToolCallKey)
+                    throw new UnattendedRunRefusedError("This automation tool needs exact owner approval", "automation_approval_required");
+                return entry.run(args, { ...context, caller: "automation" });
+            },
+        };
+    }
+    return restricted;
+}
+
+/** Stable digest binds schemas, gate settings, visibility and MCP connection identity. */
+export function automationApprovalFingerprint(value) {
+    const stable = (item) => Array.isArray(item) ? item.map(stable) :
+        item && typeof item === "object" ? Object.fromEntries(Object.keys(item).sort().map((key) => [key, stable(item[key])])) : item;
+    return createHash("sha256").update(JSON.stringify(stable(value))).digest("hex");
+}
+export function unattendedRegistryFingerprint(actions) {
+    return automationApprovalFingerprint(Object.entries(actions).sort(([a], [b]) => a.localeCompare(b)).map(([name, entry]) => ({
+        name, tool: entry.tool, needsApproval: typeof entry.needsApproval === "function" ? "predicate" : entry.needsApproval ?? false,
+        allowPersistentApproval: entry.allowPersistentApproval, agentTool: entry.agentTool,
+        mcp: entry.unattendedFingerprint ?? null,
+    })));
+}
