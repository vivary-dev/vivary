new file mode 100644
index 0000000000000000000000000000000000000000..3a59860405fc6dd9d3dde9e352f94ac85dd3af93
--- /dev/null
+++ b/dist/client/thread-save-queue.js
@@ -0,0 +1,22 @@
+const pendingByThread = new Map();
+
+export function saveThreadSnapshot({ key, observation, threadId, snapshot, headId, save }) {
+    const previous = pendingByThread.get(key) ?? Promise.resolve();
+    const current = previous.catch(() => undefined).then(async () => {
+        const receipt = await save(threadId, {
+            ...snapshot,
+            expectedHeadRevision: observation.revision,
+        });
+        if (receipt?.headApplied === true && receipt.headId === headId &&
+            Number.isSafeInteger(receipt.headRevision) && receipt.headRevision >= 0) {
+            observation.revision = receipt.headRevision;
+        }
+        return receipt;
+    });
+    pendingByThread.set(key, current);
+    void current.finally(() => {
+        if (pendingByThread.get(key) === current)
+            pendingByThread.delete(key);
+    }).catch(() => undefined);
+    return current;
+}
