+    if (!isRecord(result) || !isRecord(result.thread) || typeof result.thread.id !== "string"
+        || result.modelProvider !== "openai" || typeof result.cwd !== "string"
+        || !samePath(result.cwd, options.cwd) || (options.model && result.model !== options.model)
+        || result.approvalPolicy !== policy.approvalPolicy || result.approvalsReviewer !== "user"
+        || !isRecord(result.sandbox) || result.sandbox.type !== policy.sandboxPolicy.type) {
+        throw new Error("Codex did not apply the selected project, model, or permissions. No turn was started.");
+    }
+    if (options.threadId && result.thread.id !== options.threadId) {
+        throw new Error("Codex resumed a different conversation. No turn was started.");
+    }
+    if (policy.sandbox !== "danger-full-access") {
+        const roots = result.sandbox.writableRoots ?? [];
+        if (result.sandbox.networkAccess === true || !Array.isArray(roots)
