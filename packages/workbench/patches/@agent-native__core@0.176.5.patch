+    let depth = 0;
+    let i = 0;
+    while (i < sql.length) {
+        const start = i;
+        const ch = sql[i];
+        if (/\s/.test(ch)) { i++; continue; }
+        let kind = "symbol";
+        let value;
+        if (sql.startsWith("--", i)) {
+            i = sql.indexOf("\n", i + 2);
+            if (i < 0) i = sql.length;
+            const comment = sql.slice(start, i + (sql[i] === "\n" ? 1 : 0));
+            if (/\r(?!\n)/.test(comment))
+                fail("CR-only SQL line comments are not supported by raw DB tools.");
+            kind = "comment";
+        }
+        else if (sql.startsWith("/*", i)) {
+            const end = sql.indexOf("*/", i + 2);
+            i = end < 0 ? sql.length : end + 2;
+            if (sql.slice(start + 2, end < 0 ? i : end).includes("/*"))
+                fail("Nested SQL comments are not supported by raw DB tools.");
+            kind = "comment";
+        }
+        else if (ch === "'" || ch === '"' || ch === "`" || ch === "[") {
+            kind = ch === "'" ? "string" : "identifier";
+            const close = ch === "[" ? "]" : ch;
+            i++;
+            value = "";
+            let closed = false;
+            while (i < sql.length) {
+                if (sql[i] === close) {
+                    if (ch !== "[" && sql[i + 1] === close) {
+                        value += close;
+                        i += 2;
+                        continue;
+                    }
+                    i++;
+                    closed = true;
+                    break;
+                }
+                value += sql[i++];
+            }
+            if (!closed) fail("SQL contains an unterminated quoted value.");
+        }
+        else if (wordStart(ch)) {
+            i++;
+            while (wordPart(sql[i])) i++;
+            kind = "word";
+            value = sql.slice(start, i);
+            if ((/^[eEnNbBxX]$/.test(value) && sql[i] === "'") ||
+                (/^[uU]$/.test(value) && sql[i] === "&" && /['"]/.test(sql[i + 1] ?? ""))) {
