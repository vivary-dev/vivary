+
+function inside(root, target) {
+    const relative = path.relative(root, target);
+    return relative === "" || (!relative.startsWith(".." + path.sep) && relative !== ".." && !path.isAbsolute(relative));
+}
+
+async function inspectPath(target, allowMissing = false) {
+    const root = path.parse(target).root;
+    const components = target.slice(root.length).split(path.sep);
+    if (components.length > 128) throw new Error("unsupported path");
+    const snapshots = [];
+    let current = root;
+    for (const component of ["", ...components]) {
+        if (component) current = path.join(current, component);
+        let entry;
+        try { entry = await lstat(current, { bigint: true }); }
+        catch (error) {
+            if (allowMissing && error?.code === "ENOENT") return null;
+            throw error;
+        }
+        if (entry.isSymbolicLink() || (current !== target && !entry.isDirectory())) throw new Error("linked path");
+        snapshots.push(entry);
+    }
+    try {
+        if (await realpath(target) !== target) throw new Error("noncanonical path");
+    } catch (error) {
+        if (allowMissing && error?.code === "ENOENT") return null;
+        throw error;
+    }
+    return snapshots;
+}
+
+function sameFile(a, b) {
+    return a.dev === b.dev && a.ino === b.ino && a.mode === b.mode && a.nlink === b.nlink
+        && a.size === b.size && a.mtimeNs === b.mtimeNs && a.ctimeNs === b.ctimeNs;
+}
+
+function frameEntries(buffer, sessionId, cwd) {
+    const text = new TextDecoder("utf-8", { fatal: true }).decode(buffer);
+    if (!text.endsWith("\n")) throw new Error("incomplete");
+    const lines = text.slice(0, -1).split("\n");
+    if (lines.length > MAX_LINES) throw new Error("limit");
+    const entries = [];
+    const parents = new Map();
+    for (const line of lines) {
+        if (Buffer.byteLength(line) > MAX_LINE_BYTES) throw new Error("limit");
+        checkDepth(line);
+        const entry = JSON.parse(line);
+        if (!entry || typeof entry !== "object" || Array.isArray(entry)
+            || typeof entry.type !== "string" || entry.type.length > 64) throw new Error("entry");
+        // These are defensive identity/resource checks, not a semantic transcript parser.
+        // Metadata-only entries may omit identity; message records must prove both scopes.
+        const entryCwd = typeof entry.cwd === "string" ? claudeCwdIdentity(entry.cwd) : undefined;
+        if ((entry.sessionId !== undefined && entry.sessionId !== sessionId)
+            || (entry.session_id !== undefined && entry.session_id !== sessionId)
+            || (entry.cwd !== undefined && entryCwd !== cwd)) throw new Error("identity");
+        if ((entry.type === "user" || entry.type === "assistant")
+            && (entry.sessionId !== sessionId || entryCwd !== cwd || !UUID.test(entry.uuid ?? ""))) throw new Error("identity");
+        for (const key of ["uuid", "parentUuid", "logicalParentUuid"]) {
+            if (entry[key] !== undefined && entry[key] !== null
+                && (typeof entry[key] !== "string" || entry[key].length > 128)) throw new Error("identifier");
+        }
+        if (entry.uuid !== undefined) {
+            if (typeof entry.uuid !== "string" || parents.has(entry.uuid)) throw new Error("duplicate identity");
+            parents.set(entry.uuid, entry.parentUuid ?? null);
+        }
+        entries.push(entry);
+    }
+    const done = new Set();
+    for (const id of parents.keys()) {
+        const chain = new Set();
+        let current = id;
+        while (parents.has(current) && !done.has(current)) {
+            if (chain.has(current)) throw new Error("cycle");
+            chain.add(current);
+            current = parents.get(current);
+        }
+        for (const visited of chain) done.add(visited);
+    }
+    return entries;
+}
+
+function checkDepth(line) {
+    let depth = 0, quoted = false, escaped = false;
+    for (const character of line) {
+        if (quoted) {
+            if (escaped) escaped = false;
+            else if (character === "\\") escaped = true;
+            else if (character === '"') quoted = false;
+        } else if (character === '"') quoted = true;
+        else if (character === "{" || character === "[") {
+            if (++depth > MAX_DEPTH) throw new Error("limit");
+        } else if (character === "}" || character === "]") depth--;
+    }
+}
+
+async function interpretSnapshot(snapshot) {
+    // The SDK's opaque semantic graph runs off the server thread. Termination, not
+    // Promise.race, bounds a parser stall. env:{} removes inherited environment
+    // values only; this Node worker retains OS filesystem/network rights and is not a sandbox.
+    const sdkUrl = import.meta.resolve("@anthropic-ai/claude-agent-sdk");
+    const worker = new Worker(`(${sdkReaderWorker.toString()})()`, {
+        eval: true, workerData: { ...snapshot, sdkUrl }, env: {}, execArgv: [],
+        resourceLimits: { maxOldGenerationSizeMb: 64, maxYoungGenerationSizeMb: 16, stackSizeMb: 2 },
+        stdout: true, stderr: true,
+    });
+    // SDK diagnostics are private and never become the excerpt.
+    worker.stdout.resume();
+    worker.stderr.resume();
+    let timer;
+    try {
+        return await new Promise(resolve => {
+            timer = setTimeout(() => resolve({ status: "too-large", messages: [] }), 3000);
+            worker.once("message", resolve);
+            worker.once("error", () => resolve({ status: "unavailable", messages: [] }));
+            worker.once("exit", () => resolve({ status: "unavailable", messages: [] }));
+        });
+    } finally {
+        clearTimeout(timer);
+        await worker.terminate();
+    }
+}
+
+// Self-contained authored adapter, serialized into a Node worker so packaging
+// needs no second executable or external worker-file location.
+async function sdkReaderWorker() {
+    const { parentPort, workerData } = await import("node:worker_threads");
+    try {
+        const { entries, cwd, providerCwd, projectKey, sessionId, sdkUrl } = workerData;
+        const { getSessionInfo, getSessionMessages } = await import(sdkUrl);
+        const sessionStore = {
+            async load(key) {
+                if (key.sessionId !== sessionId || key.projectKey !== projectKey || key.subpath !== undefined) throw new Error("scope");
+                return entries;
+            },
+            async append() { throw new Error("read only"); },
+        };
+        const info = await getSessionInfo(sessionId, { dir: cwd, sessionStore });
+        const infoCwd = process.platform === "darwin" && typeof info?.cwd === "string"
+            ? info.cwd.normalize("NFC") : info?.cwd;
+        if (!info || info.sessionId !== sessionId || infoCwd !== providerCwd) {
+            parentPort.postMessage({ status: "malformed", messages: [] });
+            return;
+        }
+        const messages = await getSessionMessages(sessionId, { dir: cwd, sessionStore, includeSystemMessages: false });
+        const safe = [];
+        let characters = 0;
+        if (messages.length > 2048) throw new Error("output limit");
+        for (const entry of messages) {
+            if (entry.session_id !== sessionId) throw new Error("identity");
+            if (entry.type !== "user" && entry.type !== "assistant") continue;
+            const content = entry.message?.content;
+            const text = typeof content === "string" ? content : Array.isArray(content)
+                ? content.filter(block => block?.type === "text" && typeof block.text === "string").map(block => block.text).join("\n") : "";
+            characters += text.length;
+            if (characters > 256 * 1024) throw new Error("output limit");
+            if (text) safe.push({ role: entry.type, text });
+        }
+        parentPort.postMessage({ status: "available", messages: safe });
+    } catch {
+        parentPort.postMessage({ status: "malformed", messages: [] });
+    }
+}
