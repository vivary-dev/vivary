+import { resolveBackgroundRunHardTimeoutMs } from "../agent/run-manager.js";
+import { nextOccurrence } from "./cron.js";
+import { AUTOMATION_LEASE_STALE_MS, AUTOMATION_SCHEDULER_TICK_MS, readHeldAutomationLeases, } from "./scheduler-health.js";
+/**
+ * Vivary #140. The tick that ends a wait lands at the first tick at or after
+ * it, and a fresh launch first ticks 70 seconds in, so a wait clears within
+ * two ticks of its end.
+ */
+const WAIT_SLACK_MS = 2 * AUTOMATION_SCHEDULER_TICK_MS;
+/**
+ * Vivary #140. The clock and the held leases one list request reads once. A
+ * failed read is logged and reads as no held lease, so a running mark still
+ * waits on its run's time window.
+ */
+export async function readScheduleView(appId) {
+    const now = Date.now();
+    const view = {
+        now,
+        hardTimeoutMs: resolveBackgroundRunHardTimeoutMs(),
+        scheduler: null,
+        runs: new Map(),
+    };
+    try {
+        return { ...view, ...(await readHeldAutomationLeases({ appId, now })) };
+    }
+    catch (error) {
+        console.warn("[automations] Could not read the scheduler leases:", error instanceof Error ? error.message : error);
+        return view;
+    }
+}
+/**
+ * Vivary #140. The NEXT RUN both list actions report. While a lease or a
+ * running mark keeps the scheduler from acting on an entry, a time it cannot
+ * meet is reported as null with the wait that blocks it.
+ */
+export function listedNextRun(meta, scheduled, runKey, view) {
+    if (["waiting_approval", "resuming"].includes(meta.lastStatus))
+        return { nextRun: null, schedulerWait: { reason: "run", resumesAfter: null } };
+    if (!meta.enabled)
+        return { nextRun: null, schedulerWait: null };
+    const due = dueTime(meta, scheduled, view.now);
+    if (!scheduled || due === null)
+        return { nextRun: due, schedulerWait: null };
+    const wait = later(runWait(meta, view.runs.get(runKey), view), schedulerLeaseWait(view));
+    // By `clearsBy` the scheduler has acted on the wait. No occurrence lies
+    // between now and a later `due`, so `due` is the run it starts.
+    if (!wait || Date.parse(due) > wait.clearsBy)
+        return { nextRun: due, schedulerWait: null };
+    return {
+        nextRun: null,
+        schedulerWait: {
+            reason: wait.reason,
+            resumesAfter: wait.resumesAfter === null ? null : new Date(wait.resumesAfter).toISOString(),
+        },
+    };
+}
+// A stored `nextRun` in the past means the scheduler kept declining to run
+// the entry, not that it is overdue. Report the real next occurrence and let
+// `lastError` carry the reason it keeps being passed over.
+function dueTime(meta, scheduled, now) {
+    if (meta.nextRun) {
+        const stored = new Date(meta.nextRun).getTime();
+        if (!Number.isFinite(stored) || stored > now || !scheduled) {
+            return meta.nextRun;
+        }
+    }
+    return scheduled
+        ? nextOccurrence(meta.schedule, new Date(now), meta.timezone).toISOString()
+        : null;
+}
+function stale(lease, now) {
+    return now - lease.writtenAt > AUTOMATION_LEASE_STALE_MS;
+}
+/**
+ * A run lease or a running mark, as the scan reads them. A held lease blocks
+ * the entry whether or not its holder still renews it, because a lease killed
+ * seconds ago looks live. Renewal picks only the reason.
+ */
+function runWait(meta, lease, view) {
+    const marked = meta.lastStatus === "running";
+    if (!marked && !lease)
+        return null;
+    // The relay reports when a paired host's run ends, so it has no bound.
+    if (!lease && meta.executionHostId)
+        return { reason: "run", resumesAfter: null, clearsBy: Infinity };
+    // A mark whose start does not parse is outside every time window, so the
+    // next scan resets it, as `isBackgroundAutomationRunActive` reads it.
+    const startedAt = marked ? Date.parse(meta.lastRun) : Number.NaN;
+    const windowEnd = Number.isFinite(startedAt) ? startedAt + view.hardTimeoutMs : -Infinity;
+    const from = Math.max(lease?.expiresAt ?? -Infinity, windowEnd);
+    if (lease && !stale(lease, view.now))
+        return { reason: "run", resumesAfter: null, clearsBy: from + WAIT_SLACK_MS };
+    const at = Math.max(from, view.now);
+    return { reason: "stalled-run", resumesAfter: at, clearsBy: at + WAIT_SLACK_MS };
+}
+/** A live scan holds the scheduler lease too, so only a stale one is a wait. */
+function schedulerLeaseWait(view) {
+    const lease = view.scheduler;
+    if (!lease || !stale(lease, view.now))
+        return null;
+    return { reason: "scheduler", resumesAfter: lease.expiresAt, clearsBy: lease.expiresAt + WAIT_SLACK_MS };
+}
+function later(a, b) {
+    if (!a || !b)
+        return a ?? b;
+    return b.clearsBy > a.clearsBy ? b : a;
+}
