+const MAX_WIRE_BYTES = 512 * 1024;
+const MAX_LINE_BYTES = 128 * 1024;
+const MAX_LINES = 256;
+const MAX_DEPTH = 32;
+const MAX_TURNS = 20;
+const MAX_ITEMS = 200;
