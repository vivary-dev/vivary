+            const index = inspectionQueue.indexOf(waiter);
+            if (index !== -1) inspectionQueue.splice(index, 1);
+            resolve(false);
+        }, MAX_INSPECTION_WAIT_MS);
+        inspectionQueue.push(waiter);
+    });
+}
+
+function releaseInspection() {
+    const next = inspectionQueue.shift();
+    if (next) {
+        clearTimeout(next.timer);
+        next.resolve(true);
+    } else inspectionActive = false;
+}
+
+// SDK 0.3.288 normalizes provider cwd on Darwin only; Linux names stay distinct.
