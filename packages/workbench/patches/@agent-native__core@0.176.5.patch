+export const keyword = (token, word) => token?.kind === "word" && token.value.toUpperCase() === word;
+const wordStart = ch => ch !== undefined && /[A-Za-z_\u0080-\uffff]/.test(ch);
+const wordPart = ch => ch !== undefined && /[A-Za-z_0-9$\u0080-\uffff]/.test(ch);
