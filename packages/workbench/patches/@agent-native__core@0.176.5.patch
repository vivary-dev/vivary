+import { constants } from "node:fs";
+import { lstat, open, realpath } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { Worker } from "node:worker_threads";
+
+const MAX_BYTES = 256 * 1024;
+const MAX_LINES = 2048;
+const MAX_LINE_BYTES = 32 * 1024;
+const MAX_DEPTH = 32;
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+const MAX_WAITING_INSPECTIONS = 4;
+const MAX_INSPECTION_WAIT_MS = 15_000;
+let inspectionActive = false;
+const inspectionQueue = [];
+
+/** Host-only entry point: callers authorize the retained Native run before calling. */
+export async function readClaudeCodeSessionLog(run, options = {}) {
+    const sessionId = run.metadata?.claudeSessionId;
+    const result = { reference: typeof sessionId === "string" && UUID.test(sessionId)
+        ? `claude-session:${sessionId}` : null, status: "unsupported", messages: [] };
+    if (run.metadata?.engine !== "claude-cli" || typeof sessionId !== "string" || !UUID.test(sessionId)) return result;
+    // Custom naming/configuration has no recorded, supported exact-location reference yet.
+    // Do not scan directories or guess a hash for long project names.
+    if (process.env.CLAUDE_CONFIG_DIR || process.env.CLAUDE_CODE_PROJECT_DIR_NAME
+        || run.metadata?.claudeConfigDir || run.metadata?.claudeProjectDirName || run.metadata?.claudeSessionStore) return result;
+    const cwd = run.cwd;
+    if (typeof cwd !== "string" || !path.isAbsolute(cwd) || path.resolve(cwd) !== cwd) return result;
+    // Match SDK provider identity only; filesystem paths remain byte-exact below.
+    const providerCwd = claudeCwdIdentity(cwd);
+    const projectKey = providerCwd.replace(/[^a-zA-Z0-9]/g, "-");
+    if (projectKey.length > 200) return result;
+    const home = options.homeDirectory ?? os.homedir();
+    if (!path.isAbsolute(home)) return result;
+    const config = path.join(home, ".claude");
+    if (inside(cwd, config)) return result;
+    if (!await acquireInspection()) return { ...result, status: "unavailable" };
+    let file;
+    try {
+        // Retained history may outlive its project. Check every existing component
+        // for links, but never confuse an absent project with an absent log.
+        const project = await inspectPath(cwd, true);
+        if (project && !project.at(-1).isDirectory()) return { ...result, status: "unavailable" };
+        const logPath = path.join(config, "projects", projectKey, sessionId + ".jsonl");
+        const before = await inspectPath(logPath);
+        const target = before.at(-1);
+        if (!target.isFile() || target.nlink !== 1n) return { ...result, status: "unavailable" };
+        if (target.size > BigInt(MAX_BYTES)) return { ...result, status: "too-large" };
+        file = await open(logPath, constants.O_RDONLY | (constants.O_NOFOLLOW ?? 0) | (constants.O_NONBLOCK ?? 0));
+        const opened = await file.stat({ bigint: true });
+        if (!sameFile(target, opened)) return { ...result, status: "unavailable" };
+        // A whole snapshot only: a tail cannot establish the official parent-message chain.
+        const buffer = Buffer.alloc(MAX_BYTES + 1);
+        let length = 0;
+        while (length < buffer.length) {
+            const { bytesRead } = await file.read(buffer, length, buffer.length - length, length);
+            if (!bytesRead) break;
+            length += bytesRead;
+        }
+        const after = await inspectPath(logPath);
+        if (!sameFile(opened, await file.stat({ bigint: true })) || before.length !== after.length
+            || before.some((entry, index) => !sameFile(entry, after[index])) || BigInt(length) !== opened.size) {
+            return { ...result, status: "unavailable" };
+        }
+        if (length > MAX_BYTES) return { ...result, status: "too-large" };
