+
+// Keep one reader/worker active. Ordinary overlapping clients wait in FIFO order;
+// overload and a stalled predecessor cannot retain an unbounded queue or wait.
+function acquireInspection() {
+    if (!inspectionActive) {
+        inspectionActive = true;
+        return Promise.resolve(true);
+    }
+    if (inspectionQueue.length >= MAX_WAITING_INSPECTIONS) return Promise.resolve(false);
