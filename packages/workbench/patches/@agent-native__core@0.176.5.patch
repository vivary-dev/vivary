+import type { JobFrontmatter } from "./frontmatter.js";
+import type { HeldAutomationLease } from "./scheduler-health.js";
+/**
+ * Vivary #140. Why the scheduler cannot act on an entry yet. A `run` holds
+ * until the current run ends. The others hold until `resumesAfter` and then up
+ * to two scheduler ticks more.
+ */
+export type SchedulerWait = {
+    reason: "run";
+    resumesAfter: null;
+} | {
+    reason: "stalled-run" | "scheduler";
+    resumesAfter: string;
+};
+export interface ScheduleView {
+    now: number;
+    hardTimeoutMs: number;
+    scheduler: HeldAutomationLease | null;
+    runs: Map<string, HeldAutomationLease>;
+}
+/**
+ * Vivary #140. The clock and the held leases one list request reads once. A
+ * failed read is logged and reads as no held lease, so a running mark still
+ * waits on its run's time window.
+ */
+export declare function readScheduleView(appId?: string): Promise<ScheduleView>;
+/**
+ * Vivary #140. The NEXT RUN both list actions report. While a lease or a
+ * running mark keeps the scheduler from acting on an entry, a time it cannot
+ * meet is reported as null with the wait that blocks it.
+ */
+export declare function listedNextRun(meta: JobFrontmatter, scheduled: boolean, runKey: string, view: ScheduleView): {
+    nextRun: string | null;
+    schedulerWait: SchedulerWait | null;
+};
