{
  "name": "@vivary/workbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Unreleased Vivary workbench shell and project application services.",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  },
  "dependencies": {
    "@agent-native/core": "0.176.5",
    "@agent-native/toolkit": "0.19.3",
    "@fontsource-variable/inter": "5.3.0",
    "@tabler/icons-react": "3.46.0",
    "@tanstack/react-query": "5.102.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "h3": "2.0.1-rc.31",
    "zod": "4.5.4",
    "next-themes": "0.4.6"
  },
  "scripts": {
    "test:registry": "node --test tests/registry-store.test.mjs",
    "test:registry-actions": "node --test tests/registry-actions.test.mjs",
    "test:registry-http": "node --test tests/registry-http.test.mjs",
    "build": "node bin/runtime-security.mjs run ./node_modules/@agent-native/core/package.json agent-native build",
    "dev": "agent-native dev",
    "start": "node bin/start.mjs",
    "typecheck": "agent-native typecheck",
    "test:shell": "vitest run tests/workbench-preview.test.ts",
    "doctor": "agent-native doctor",
    "test:project-services": "node --test tests/project-services.test.mjs"
  },
  "devDependencies": {
    "@react-router/dev": "8.3.1",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/node": "25.9.5",
    "vite": "8.1.6",
    "vitest": "4.1.12",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "esbuild": "0.28.2"
  },
  "bin": {
    "vivary-gui": "bin/start.mjs"
  }
}
