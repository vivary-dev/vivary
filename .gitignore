# Python
__pycache__/
*.pyc
.venv/
dist/
dist_*/
build/
*.egg-info/
.pytest_cache/
packages/core/tests/.fixtures/

# Node
node_modules/
.tmp/
packages/workbench/.output/
packages/workbench/.react-router/
packages/workbench/.cache/
packages/workbench/.data/
packages/workbench/.agent-native/

# Editor / OS
.DS_Store
.idea/
.vscode/
.obsidian/

# Disposable test workspaces (keep the README, ignore the rest)
sandboxes/*
!sandboxes/README.md

# Local proof receipts
/orientation-proof.json

# Canonical Strato skills are source files even if a global ignore hides .claude/
!packages/strato/.claude/
!packages/strato/.claude/skills/
!packages/strato/.claude/skills/active-context/
!packages/strato/.claude/skills/active-context/**

# Tracked source under .claude/ (every skill, not just verify) stays
# visible even if a global ignore hides .claude/. Anchored to the repo
# root (leading /) so this cannot affect any other .claude/ directory
# (for example packages/strato/.claude/ above, or a nested
# packages/*/.claude/). No blanket /.claude/* or /.claude/skills/*
# ignore: that hid new source in every other tracked skill
# (discussion_r4504090672), not just unreviewed verify features. The
# repo's own __pycache__/ and *.pyc rules, above, are earlier in this
# file, so the recursive re-include below would otherwise undo them for
# anything under .claude/; re-assert local-only exclusions here, after
# the re-include, scoped to .claude/ so nothing here duplicates those
# repo-wide rules.
!/.claude/
!/.claude/skills/
!/.claude/skills/**
/.claude/**/settings.local.json
/.claude/**/__pycache__/
/.claude/**/*.pyc

# Local drafts
drafts/
.release/private/
HANDOFF.md

# Generated from docs/assets during site builds
/site/public/assets/walkthrough/
# CocoIndex Code (ccc)
/.cocoindex_code/

# Vivary runtime data (storage.toml is committed; data/ is not)
/.vivary/data/

# Share only Entire routing. Keep local settings, metadata, logs and transcripts private.
/.entire/*
!/.entire/settings.json
