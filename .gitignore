# Python
__pycache__/
*.pyc
.venv/
dist/
dist_*/
build/
*.egg-info/
.pytest_cache/
packages/core/tests/.fixtures/

# Node
node_modules/
.tmp/
packages/workbench/.output/
packages/workbench/.react-router/
packages/workbench/.cache/
packages/workbench/.data/
packages/workbench/.agent-native/

# Editor / OS
.DS_Store
.idea/
.vscode/
.obsidian/

# Disposable test workspaces (keep the README, ignore the rest)
sandboxes/*
!sandboxes/README.md

# Local proof receipts
/orientation-proof.json

# Canonical Strato skills are source files even if a global ignore hides .claude/
!packages/strato/.claude/
!packages/strato/.claude/skills/
!packages/strato/.claude/skills/active-context/
!packages/strato/.claude/skills/active-context/**

# The verify skill's tracked source files are source files even if a
# global ignore hides .claude/. Anchored to the repo root (leading /) so
# this cannot affect any other .claude/ directory (for example
# packages/strato/.claude/ above, or a nested packages/*/.claude/), and
# scoped to the skill's own known file set, plus any new features/*.md,
# so generated bytecode and local settings stay hidden.
!/.claude/
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/verify/
/.claude/skills/verify/*
!/.claude/skills/verify/SKILL.md
!/.claude/skills/verify/key.py
!/.claude/skills/verify/test_key.py
!/.claude/skills/verify/acceptance.md
!/.claude/skills/verify/fixtures.json
!/.claude/skills/verify/features/
!/.claude/skills/verify/features/*.md

# Local drafts
drafts/
.release/private/
HANDOFF.md

# Generated from docs/assets during site builds
/site/public/assets/walkthrough/
# CocoIndex Code (ccc)
/.cocoindex_code/

# Vivary runtime data (storage.toml is committed; data/ is not)
/.vivary/data/

# Share only Entire routing. Keep local settings, metadata, logs and transcripts private.
/.entire/*
!/.entire/settings.json
