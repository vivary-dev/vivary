---
const repo = 'https://github.com/vivary-dev/vivary';
const command = 'uvx create-vivary init my-workspace --preset coding --no-wizard';
const supportEmail = 'support@vivary.dev';
const supportSubject = 'Vivary support request';
const supportIssueUrl = `${repo}/issues/new?template=bug.yml&labels=bug&title=${encodeURIComponent('[Bug]: Vivary problem report')}`;
const supportBody = [
  'Hi Vivary team,',
  '',
  'I hit a problem with Vivary.',
  '',
  'What I ran:',
  '',
  'What happened:',
  '',
  'What I expected:',
  '',
  'Vivary version or command output:',
  '',
  'Relevant receipt/log summary:',
].join('\n');
const supportMailto = `mailto:${supportEmail}?subject=${encodeURIComponent(supportSubject)}&body=${encodeURIComponent(supportBody)}`;

const layers = [
  {
    name: 'tropo',
    eyebrow: 'The substrate',
    body: 'A typed knowledge graph for what the workspace knows, where truth lives, and what depends on it.',
  },
  {
    name: 'strato',
    eyebrow: 'The operating layer',
    body: 'One visible state surface, private boundaries, and a governed loop that grows only when real work earns context.',
  },
  {
    name: 'ozone',
    eyebrow: 'The protective filter',
    body: 'Graph-aware review and human gates for changes that are durable, destructive, or outward-facing.',
  },
  {
    name: 'exo',
    eyebrow: 'The coordination layer',
    body: 'Claims, conflicts, and role contracts for the moment one agent becomes many.',
  },
];

const adoption = [
  {
    step: '01',
    title: 'Map the terrain',
    command: 'tropo map --root .',
    body: 'Read a large repo, vault, or docs tree without opening everything. No config and no writes.',
  },
  {
    step: '02',
    title: 'Adopt without wrecking it',
    command: 'create-vivary adopt . --json',
    body: 'Preview the exact hash first: at most three payload files and two bounded host integrations.',
  },
  {
    step: '03',
    title: 'Keep it healthy',
    command: 'create-vivary doctor .',
    body: 'Verify the thin contract and privacy boundary without writing runtime trend state.',
  },
];

const faq = [
  {
    question: 'What is Vivary?',
    answer:
      'Vivary is a local-first governed-context standard and scaffolder. Core starts with five small files: one context capsule, one visible state surface, policy, startup routing, and private/runtime ignores.',
  },
  {
    question: 'Can I use it with an existing project?',
    answer:
      'Yes. Brownfield adoption starts with a deterministic dry-run, adds at most three Vivary payload files, and touches only bounded generated blocks in AGENTS.md and .gitignore after exact-hash approval.',
  },
  {
    question: 'Is Vivary an AI agent or model?',
    answer:
      'No. Vivary is the workspace structure around your agents. It works with tools such as Claude Code and Codex without replacing the agent, editor, model, Git, or issue tracker you already use.',
  },
  {
    question: 'Does it upload or index my files?',
    answer:
      'Not by default. Core is local and dependency-light. Optional MCP is local stdio and read-only; networked providers and semantic indexing require separate installation and approval.',
  },
  {
    question: 'Am I locked into Vivary?',
    answer:
      'No. Project truth stays in Markdown, YAML, and ordinary folders. You can inspect it, version it with Git, edit it anywhere, and remove the Vivary tooling without trapping your work in a hosted platform.',
  },
  {
    question: 'Is it open source and production-ready?',
    answer:
      'Vivary is MIT licensed. The five-file 0.4.2 scaffolder, the governed roles, and the optional MCP adapter are published on PyPI and npm, and each version was verified from the public registries on 2026-08-15. Vivary is pre-1.0, so treat it as production-ready for local governed context and read the release status before you pin a version.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Vivary — a world your agents can understand</title>
    <meta
      name="description"
      content="Vivary gives agents lightweight governed context, visible state, receipts, and human gates without seeding a second brain."
    />
    <meta property="og:title" content="Vivary — a world your agents can understand" />
    <meta
      property="og:description"
      content="Five small workspace files, earned context, receipts, and human gates."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://vivary.vercel.app/" />
    <meta property="og:site_name" content="Vivary" />
    <meta property="og:image" content="https://vivary.vercel.app/media/hero-living-strata.webp" />
    <meta
      property="og:image:alt"
      content="A living world in luminous layers, with typed roots leading toward a protected gate."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Vivary — a world your agents can understand" />
    <meta
      name="twitter:description"
      content="Five small workspace files, earned context, receipts, and human gates."
    />
    <meta name="twitter:image" content="https://vivary.vercel.app/media/hero-living-strata.webp" />
    <link rel="canonical" href="https://vivary.vercel.app/" />
    <meta name="theme-color" content="#020916" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/hanken-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="brand" href="/" aria-label="Vivary home">
        <img src="/media/vivary-mark.png" alt="" width="40" height="40" />
        <span>Vivary</span>
      </a>

      <nav class="desktop-nav" aria-label="Primary navigation">
        <a href="/getting-started/">Docs</a>
        <a href="/white-paper/">White paper</a>
        <a href="/roadmap/">Roadmap</a>
        <a href="#faq">FAQ</a>
        <a href={repo}>GitHub</a>
        <a class="nav-cta" href="/getting-started/">Get started</a>
      </nav>

      <details class="mobile-nav">
        <summary>Menu</summary>
        <nav aria-label="Mobile navigation">
          <a href="/getting-started/">Docs</a>
          <a href="/white-paper/">White paper</a>
          <a href="/roadmap/">Roadmap</a>
          <a href="#faq">FAQ</a>
          <a href={repo}>GitHub</a>
        </nav>
      </details>
    </header>

    <main id="main">
      <section class="hero">
        <img
          class="hero-world"
          src="/media/hero-living-strata.webp"
          alt="A living world shown in luminous layers, with roots carrying signals toward a protected gate."
          width="1792"
          height="1024"
          fetchpriority="high"
        />
        <div class="hero-copy">
          <p class="eyebrow">Small seed · earned context · human gates</p>
          <h1>Give agents governed context without the file pack.</h1>
          <p class="hero-lede">
            Greenfield Core creates five operational files and no starter second
            brain. Brownfield adoption stays capped and review-first. MCP reads and
            supplies capsules; a separate exact-hash transaction writes one earned record.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="/getting-started/">Start with an existing project</a>
            <a class="button button-secondary" href="/white-paper/">Read the white paper</a>
          </div>
          <div class="command" aria-label={`Install command: ${command}`}>
            <code><span aria-hidden="true">&gt;_</span> {command}</code>
            <button type="button" data-copy={command}>Copy command</button>
            <span class="copy-status" data-copy-status aria-live="polite"></span>
          </div>
          <p class="release-truth">
            Published 0.4.2 on PyPI and npm, verified from the public registries on
            2026-08-15. See the <a href="/release-workflow/">release workflow</a> for how
            that status is set.
          </p>
          <ul class="hero-proof" aria-label="Vivary product facts">
            <li>Exactly five seed files</li>
            <li>No starter records</li>
            <li>Local-first + MIT</li>
          </ul>
        </div>
      </section>

      <section class="layers band" aria-labelledby="layers-title">
        <div class="layers-visual">
          <img
            src="/media/architecture-layers.webp"
            alt="Four illuminated plates stacked as one connected system."
            width="1254"
            height="1254"
            loading="lazy"
          />
        </div>
        <div class="layers-copy">
          <p class="section-label">One world. Four layers.</p>
          <h2 id="layers-title">A small atmosphere for long-running work.</h2>
          <ol>
            {layers.map((layer) => (
              <li>
                <div>
                  <span>{layer.eyebrow}</span>
                  <h3>{layer.name}</h3>
                </div>
                <p>{layer.body}</p>
              </li>
            ))}
          </ol>
          <a class="text-link" href="/architecture/">Explore the architecture</a>
        </div>
      </section>

      <section class="thesis band">
        <p class="section-label">The product thesis</p>
        <div>
          <h2>Agents do better work when context is small, typed, and earned.</h2>
          <p>
            Pre-populated workspaces invent truth and consume the context they were
            meant to protect. Vivary starts with one bounded context capsule and one
            visible state surface. Real records arrive through verified work and a
            deliberate write gate.
          </p>
        </div>
      </section>

      <section class="adoption band" aria-labelledby="adoption-title">
        <div class="section-heading">
          <p class="section-label">Brownfield without takeover</p>
          <h2 id="adoption-title">Adopt the project you already have.</h2>
          <p>
            The adoption path is deliberately read-first, bounded, and exact-hash
            gated. Existing project structure stays in charge.
          </p>
        </div>
        <ol class="adoption-flow">
          {adoption.map((item) => (
            <li>
              <span class="step">{item.step}</span>
              <h3>{item.title}</h3>
              <code>{item.command}</code>
              <p>{item.body}</p>
            </li>
          ))}
        </ol>
        <p class="adoption-note">
          One front door covers the common work. The <code>vivary</code> meta package
          routes ten task verbs to these commands: <code>create</code>,
          <code>adopt</code>, <code>doctor</code>, <code>capabilities</code>,
          <code>check</code>, <code>find</code>, <code>decide</code>,
          <code>review</code>, <code>impact</code>, and <code>control</code>. Those
          verbs ship in <code>vivary</code> 0.2.0 and are not yet on PyPI. The
          standalone commands stay the advanced surface with every operation. See the
          <a href="/commands/">command reference</a>.
        </p>
        <div class="adoption-actions">
          <a class="button button-primary" href="/getting-started/">Run the adoption path</a>
          <a class="text-link" href="/walkthrough/">See the public walkthrough</a>
        </div>
      </section>

      <section class="proof band">
        <div class="proof-copy">
          <p class="section-label">Proof before promise</p>
          <h2>The claim is measurable.</h2>
          <p>
            Vivary should reduce the tokens and wrong-file opens an agent spends
            finding project truth. The roadmap prioritizes a rerunnable benchmark,
            brownfield proof, retention through doctor, and honest public signals.
          </p>
          <div class="proof-links">
            <a class="text-link" href="/roadmap/">Read the high-leverage roadmap</a>
            <a class="text-link" href="/signals/">Inspect public signals</a>
          </div>
        </div>
        <figure>
          <img src="/usage-snapshot.svg" alt="Vivary public usage snapshot" loading="lazy" />
          <figcaption>Reviewed public package and repository signals—not a traction claim.</figcaption>
        </figure>
      </section>

      <section class="faq band" id="faq" aria-labelledby="faq-title">
        <div class="faq-heading">
          <p class="section-label">Quick answers</p>
          <h2 id="faq-title">Before you bring it into a real project.</h2>
          <p>
            The short version of what Vivary is, what it touches, and where the
            current evidence stops.
          </p>
        </div>
        <div class="faq-list">
          {faq.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="paper band">
        <p class="section-label">The deeper argument</p>
        <h2>Why agent workspaces need a standard.</h2>
        <p>
          The white paper defines the system invariants, architecture, threat model,
          human-gate protocol, evidence ledger, and benchmark that keep Vivary's
          claims falsifiable.
        </p>
        <div class="paper-actions">
          <a class="button button-primary" href="/white-paper/">Read the white paper</a>
          <a class="button button-secondary" href="#faq">Challenge it in the FAQ</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-brand">
        <img src="/media/vivary-mark.png" alt="" width="30" height="30" loading="lazy" />
        <span>Vivary</span>
      </div>
      <nav aria-label="Footer navigation">
        <a href="/getting-started/">Docs</a>
        <a href="/blog/">Blog</a>
        <a href="/white-paper/">White paper</a>
        <a href="/roadmap/">Roadmap</a>
        <a href="#faq">FAQ</a>
        <a href={repo}>GitHub</a>
        <button class="footer-support" type="button" data-support-open>Support</button>
      </nav>
      <p>A flagship from The Little AI Company.</p>
    </footer>

    <div class="support-modal" data-support-modal hidden>
      <div class="support-backdrop" data-support-close aria-hidden="true"></div>
      <section
        class="support-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="support-title"
        aria-describedby="support-description"
      >
        <button class="support-close" type="button" data-support-close aria-label="Close support dialog">×</button>
        <p class="support-eyebrow">Support</p>
        <h2 id="support-title">Send a useful problem report</h2>
        <p id="support-description">
          Copy the address or the prepared report. The email and issue links are
          prefilled, and nothing is transmitted by this page.
        </p>
        <div class="support-field" data-support-email>
          <span>{supportEmail}</span>
          <button class="support-copy" type="button" data-copy={supportEmail}>Copy</button>
        </div>
        <label class="support-report-label" for="support-report">Report draft</label>
        <textarea id="support-report" class="support-report" data-support-report readonly>{supportBody}</textarea>
        <div class="support-actions">
          <button class="button button-primary" type="button" data-copy-support>Copy report</button>
          <a class="button button-secondary" href={supportMailto}>Open email</a>
          <a class="button button-secondary" href={supportIssueUrl}>GitHub issue</a>
        </div>
      </section>
    </div>

    <script is:inline>
      const status = document.querySelector('[data-copy-status]');

      const copyToClipboard = async (text) => {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          return;
        }
        const field = document.createElement('textarea');
        field.value = text;
        field.setAttribute('readonly', '');
        field.style.position = 'fixed';
        field.style.left = '-9999px';
        document.body.appendChild(field);
        field.select();
        const copied = document.execCommand('copy');
        field.remove();
        if (!copied) throw new Error('copy failed');
      };

      const flashButton = (button, label) => {
        const original = button.textContent;
        button.textContent = label;
        window.setTimeout(() => {
          button.textContent = original;
        }, 1800);
      };

      document.querySelectorAll('[data-copy]').forEach((button) => {
        button.addEventListener('click', async () => {
          try {
            await copyToClipboard(button.dataset.copy || '');
            flashButton(button, 'Copied');
            if (button.closest('.command') && status) {
              status.textContent = 'Command copied to clipboard.';
              window.setTimeout(() => {
                status.textContent = '';
              }, 1800);
            }
          } catch {
            flashButton(button, 'Select text');
            if (button.closest('.command') && status) {
              status.textContent = 'Clipboard access was unavailable. Select the command text instead.';
            }
          }
        });
      });

      const modal = document.querySelector('[data-support-modal]');
      const report = document.querySelector('[data-support-report]');
      const reportCopy = document.querySelector('[data-copy-support]');
      const defaultReport = report?.value || '';
      let lastFocus = null;

      const safePage = () => {
        const href = window.location.href;
        return href.startsWith('http://') || href.startsWith('https://') ? href : '(local page omitted)';
      };

      const safeSource = (value) => {
        if (!value) return '(unknown source)';
        return value.startsWith('http://') || value.startsWith('https://') ? value : '(local source omitted)';
      };

      const safeDetail = (value) => String(value || '(none)')
        .replace(/file:\/\/\/[^)\s'"]+/gi, '(local path omitted)')
        .replace(/[A-Z]:[\\/][^)\s'"]+/gi, '(local path omitted)')
        .replace(/\\\\[^)\s'"]+/g, '(network path omitted)');

      const buildProblemReport = (summary, detail) => [
        defaultReport,
        '',
        'Detected by website:',
        summary,
        '',
        'Detail:',
        safeDetail(detail),
        '',
        `Page: ${safePage()}`,
      ].join('\n');

      const openSupport = (problem) => {
        if (!modal) return;
        lastFocus = document.activeElement;
        if (report) report.value = typeof problem === 'string' ? problem : defaultReport;
        modal.hidden = false;
        document.body.classList.add('support-open');
        document.querySelector('main')?.setAttribute('inert', '');
        document.querySelector('.site-header')?.setAttribute('inert', '');
        document.querySelector('.site-footer')?.setAttribute('inert', '');
        modal.querySelector('.support-close')?.focus();
      };

      const closeSupport = () => {
        if (!modal) return;
        modal.hidden = true;
        document.body.classList.remove('support-open');
        document.querySelector('main')?.removeAttribute('inert');
        document.querySelector('.site-header')?.removeAttribute('inert');
        document.querySelector('.site-footer')?.removeAttribute('inert');
        lastFocus?.focus?.();
      };

      document.querySelectorAll('[data-support-open]').forEach((button) => {
        button.addEventListener('click', () => openSupport());
      });
      modal?.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('[data-support-close]')) closeSupport();
      });
      document.addEventListener('keydown', (event) => {
        if (!modal || modal.hidden) return;
        if (event.key === 'Escape') {
          closeSupport();
          return;
        }
        if (event.key !== 'Tab') return;
        const focusable = Array.from(modal.querySelectorAll('a[href], button:not([disabled]), textarea:not([disabled])'));
        if (!focusable.length) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });
      window.addEventListener('error', (event) => {
        openSupport(buildProblemReport(
          'Browser error noticed by the Vivary website.',
          `${event.message || 'unknown error'} ${safeSource(event.filename || '')}:${event.lineno || ''}:${event.colno || ''}`.trim(),
        ));
      });
      window.addEventListener('unhandledrejection', (event) => {
        const reason = event.reason instanceof Error ? event.reason.message : String(event.reason || 'unknown rejection');
        openSupport(buildProblemReport('Unhandled browser promise rejection noticed by the Vivary website.', reason));
      });
      reportCopy?.addEventListener('click', async () => {
        try {
          await copyToClipboard(report?.value || '');
          flashButton(reportCopy, 'Copied');
        } catch {
          flashButton(reportCopy, 'Select text');
        }
      });
    </script>

    <style is:global>
      @font-face {
        font-family: 'Bricolage Grotesque';
        font-weight: 400 800;
        font-display: swap;
        src: url('/fonts/bricolage-grotesque-latin.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Hanken Grotesk';
        font-weight: 400 700;
        font-display: swap;
        src: url('/fonts/hanken-grotesk-latin.woff2') format('woff2');
      }
      @font-face {
        font-family: 'JetBrains Mono';
        font-weight: 400 600;
        font-display: swap;
        src: url('/fonts/jetbrains-mono-latin.woff2') format('woff2');
      }

      :root {
        color-scheme: dark;
        --ink: #020916;
        --ink-soft: #051420;
        --surface: #071a25;
        --surface-strong: #0b2230;
        --line: rgba(176, 229, 207, 0.17);
        --line-strong: rgba(176, 229, 207, 0.34);
        --bone: #f1f7f3;
        --muted: #a9bbb5;
        --mint: #49e1b1;
        --mint-pale: #a9f2c9;
        --blue: #52b6d8;
      }

      * {
        box-sizing: border-box;
      }

      html {
        background: var(--ink);
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--ink);
        color: var(--bone);
        font-family: 'Hanken Grotesk', system-ui, sans-serif;
        font-size: 16px;
        line-height: 1.6;
        text-rendering: optimizeLegibility;
      }

      body::selection {
        background: var(--mint);
        color: var(--ink);
      }

      a {
        color: inherit;
      }

      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }

      :focus-visible {
        outline: 3px solid var(--mint-pale);
        outline-offset: 4px;
      }

      .skip-link {
        position: fixed;
        z-index: 100;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.65rem 0.9rem;
        background: var(--bone);
        color: var(--ink);
        transform: translateY(-150%);
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      .site-header,
      .site-footer,
      .band {
        width: min(1376px, calc(100% - 64px));
        margin-inline: auto;
      }

      .site-header {
        position: relative;
        z-index: 5;
        min-height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--line);
      }

      .brand,
      .footer-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        color: var(--bone);
        font-family: 'Bricolage Grotesque', sans-serif;
        font-size: 1.42rem;
        font-weight: 750;
        letter-spacing: -0.035em;
        text-decoration: none;
      }

      .brand img,
      .footer-brand img {
        object-fit: contain;
      }

      .desktop-nav {
        display: flex;
        align-items: center;
        gap: 1.7rem;
      }

      .desktop-nav a,
      .site-footer nav a,
      .footer-support,
      .mobile-nav a {
        color: var(--muted);
        font-size: 0.93rem;
        font-weight: 600;
        text-decoration: none;
      }

      .desktop-nav a:hover,
      .site-footer nav a:hover,
      .footer-support:hover,
      .mobile-nav a:hover {
        color: var(--bone);
      }

      .desktop-nav .nav-cta {
        padding: 0.65rem 1rem;
        border: 1px solid var(--line-strong);
        border-radius: 999px;
        color: var(--bone);
      }

      .mobile-nav {
        display: none;
      }

      .hero {
        position: relative;
        min-height: 570px;
        overflow: hidden;
        border-bottom: 1px solid var(--line);
      }

      .hero::after {
        content: '';
        position: absolute;
        inset: auto 0 0;
        height: 1px;
        background: var(--line);
      }

      .hero-world {
        position: absolute;
        z-index: 0;
        top: -22px;
        left: 0;
        width: 100%;
        height: 620px;
        object-fit: cover;
        object-position: center;
        opacity: 0.96;
      }

      .hero-copy {
        position: relative;
        z-index: 1;
        width: min(1376px, calc(100% - 64px));
        margin-inline: auto;
        padding: 48px 0 34px;
      }

      .hero-copy > * {
        width: min(850px, 62vw);
      }

      .eyebrow,
      .section-label {
        margin: 0 0 1.15rem;
        color: var(--mint);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.76rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3 {
        margin: 0;
        font-family: 'Bricolage Grotesque', sans-serif;
        text-wrap: balance;
      }

      h1 {
        max-width: 850px;
        font-size: clamp(3.55rem, 4.8vw, 5.6rem);
        font-weight: 770;
        letter-spacing: -0.065em;
        line-height: 0.92;
      }

      h2 {
        font-size: clamp(2.5rem, 4.3vw, 4.7rem);
        font-weight: 720;
        letter-spacing: -0.05em;
        line-height: 0.98;
      }

      h3 {
        font-size: 1.35rem;
        letter-spacing: -0.025em;
      }

      .hero-lede {
        margin: 2rem 0 0;
        max-width: 610px;
        color: #c5d2ce;
        font-size: clamp(1.05rem, 1.4vw, 1.28rem);
        line-height: 1.55;
      }

      .hero-actions,
      .paper-actions,
      .adoption-actions,
      .proof-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.85rem;
      }

      .hero-actions {
        margin-top: 2rem;
      }

      .button {
        display: inline-flex;
        min-height: 50px;
        align-items: center;
        justify-content: center;
        padding: 0.8rem 1.15rem;
        border: 1px solid var(--line-strong);
        border-radius: 0.4rem;
        font-weight: 700;
        text-decoration: none;
      }

      .button-primary {
        border-color: var(--mint);
        background: var(--mint);
        color: var(--ink);
      }

      .button-primary:hover {
        background: var(--mint-pale);
      }

      .button-secondary:hover {
        border-color: var(--mint);
        color: var(--mint);
      }

      .command {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 1rem;
        padding: 1rem 1.1rem;
        border: 1px solid var(--line-strong);
        border-radius: 0.45rem;
        background: rgba(2, 9, 22, 0.88);
      }

      .command code,
      .adoption-flow code {
        color: var(--bone);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.86rem;
      }

      .command code span {
        margin-right: 0.75rem;
        color: var(--mint);
      }

      .release-truth {
        max-width: 650px;
        margin: 0.85rem 0 0;
        color: #9fb2ad;
        font-size: 0.88rem;
      }

      .release-truth a {
        color: var(--mint);
      }

      .command button {
        flex: 0 0 auto;
        border: 0;
        background: transparent;
        color: var(--mint);
        cursor: pointer;
        font: 600 0.82rem 'Hanken Grotesk', sans-serif;
      }

      .copy-status {
        position: absolute;
        overflow: hidden;
        width: 1px;
        height: 1px;
        clip: rect(0 0 0 0);
      }

      .hero-proof {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem 1.6rem;
        margin: 1.15rem 0 0;
        padding: 0;
        color: var(--muted);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        list-style: none;
      }

      .band {
        padding-block: clamp(72px, 10vw, 140px);
        border-bottom: 1px solid var(--line);
      }

      .thesis {
        display: grid;
        grid-template-columns: 0.7fr 2fr;
        gap: 5rem;
      }

      .thesis h2 {
        max-width: 900px;
      }

      .thesis p:last-child,
      .section-heading > p,
      .proof-copy > p,
      .paper > p {
        max-width: 720px;
        margin: 1.6rem 0 0;
        color: var(--muted);
        font-size: 1.1rem;
      }

      .layers {
        display: grid;
        grid-template-columns: minmax(320px, 0.78fr) 1.22fr;
        gap: clamp(3rem, 7vw, 7rem);
        align-items: center;
        padding-block: 48px 112px;
      }

      .layers-visual img {
        display: block;
        width: 100%;
        height: auto;
      }

      .layers-copy h2 {
        max-width: 780px;
      }

      .layers-copy ol {
        margin: 3rem 0 2rem;
        padding: 0;
        list-style: none;
      }

      .layers-copy li {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 2rem;
        padding: 1.2rem 0;
        border-top: 1px solid var(--line);
      }

      .layers-copy li:last-child {
        border-bottom: 1px solid var(--line);
      }

      .layers-copy li span {
        color: var(--muted);
        font: 0.68rem 'JetBrains Mono', monospace;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .layers-copy h3 {
        margin-top: 0.15rem;
        color: var(--mint-pale);
      }

      .layers-copy li:nth-child(3) h3,
      .layers-copy li:nth-child(4) h3 {
        color: var(--blue);
      }

      .layers-copy li p {
        margin: 0;
        color: #b8c7c2;
      }

      .text-link {
        color: var(--mint);
        font-weight: 700;
        text-underline-offset: 0.22em;
      }

      .adoption {
        --adoption-gutter: clamp(1.75rem, 3.5vw, 3.5rem);

        padding-inline: var(--adoption-gutter);
        background: var(--ink-soft);
      }

      .section-heading {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 2rem 5rem;
      }

      .section-heading .section-label {
        grid-column: 1 / -1;
      }

      .section-heading > p {
        margin-top: 0;
      }

      .adoption-flow {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0;
        margin: 4rem 0 2rem;
        padding: 0;
        border-block: 1px solid var(--line);
        list-style: none;
      }

      .adoption-flow li {
        min-height: 300px;
        padding: 2rem clamp(1.5rem, 2.5vw, 2.5rem);
        border-right: 1px solid var(--line);
      }

      .adoption-flow li:last-child {
        border-right: 0;
      }

      .step {
        display: block;
        margin-bottom: 2.8rem;
        color: var(--mint);
        font: 0.75rem 'JetBrains Mono', monospace;
      }

      .adoption-flow code {
        display: block;
        overflow-x: auto;
        margin: 1.4rem 0;
        color: var(--mint-pale);
        white-space: nowrap;
      }

      .adoption-flow p {
        margin: 0;
        color: var(--muted);
      }

      .adoption-note {
        margin: 2.4rem 0 0;
        max-width: 62ch;
        color: var(--muted);
      }

      .adoption-note code {
        color: var(--mint-pale);
      }

      .proof {
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        gap: 6rem;
        align-items: center;
      }

      .proof-links {
        margin-top: 2rem;
      }

      .proof figure {
        margin: 0;
      }

      .proof figure img {
        display: block;
        width: 100%;
        height: auto;
        border: 1px solid var(--line);
        background: var(--surface);
      }

      .proof figcaption {
        margin-top: 0.8rem;
        color: var(--muted);
        font-size: 0.8rem;
      }

      .faq {
        display: grid;
        grid-template-columns: minmax(280px, 0.72fr) 1.28fr;
        gap: clamp(3rem, 8vw, 8rem);
        align-items: start;
      }

      .faq-heading {
        position: sticky;
        top: 2rem;
      }

      .faq-heading h2 {
        max-width: 620px;
      }

      .faq-heading > p:last-child {
        max-width: 52ch;
        margin: 1.6rem 0 0;
        color: var(--muted);
        font-size: 1.05rem;
      }

      .faq-list {
        border-top: 1px solid var(--line);
      }

      .faq-list details {
        border-bottom: 1px solid var(--line);
      }

      .faq-list summary {
        position: relative;
        padding: 1.55rem 3rem 1.55rem 0;
        cursor: pointer;
        font-family: 'Bricolage Grotesque', sans-serif;
        font-size: 1.28rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        list-style: none;
      }

      .faq-list summary::-webkit-details-marker {
        display: none;
      }

      .faq-list summary::after {
        content: '+';
        position: absolute;
        top: 1.45rem;
        right: 0.25rem;
        color: var(--mint);
        font: 400 1.5rem 'JetBrains Mono', monospace;
      }

      .faq-list details[open] summary::after {
        content: '−';
      }

      .faq-list details > p {
        max-width: 68ch;
        margin: -0.45rem 3rem 1.6rem 0;
        color: var(--muted);
      }

      .paper {
        max-width: 1376px;
        text-align: center;
      }

      .paper .section-label,
      .paper > p,
      .paper h2 {
        margin-inline: auto;
      }

      .paper h2 {
        max-width: 850px;
      }

      .paper-actions {
        justify-content: center;
        margin-top: 2rem;
      }

      .site-footer {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 2rem;
        align-items: center;
        min-height: 150px;
      }

      .site-footer nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1.3rem;
      }

      .site-footer p {
        margin: 0;
        color: var(--muted);
        font-size: 0.82rem;
        text-align: right;
      }

      .footer-support {
        padding: 0;
        border: 0;
        background: transparent;
        cursor: pointer;
        font-family: inherit;
      }

      body.support-open {
        overflow: hidden;
      }

      .support-modal[hidden] {
        display: none;
      }

      .support-modal {
        position: fixed;
        z-index: 30;
        inset: 0;
        display: grid;
        place-items: center;
        padding: 1.25rem;
      }

      .support-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(2, 9, 22, 0.82);
        backdrop-filter: blur(8px);
      }

      .support-dialog {
        position: relative;
        width: min(100%, 680px);
        max-height: calc(100vh - 2.5rem);
        overflow: auto;
        padding: clamp(1.5rem, 4vw, 2.5rem);
        border: 1px solid var(--line-strong);
        border-radius: 0.55rem;
        background: var(--surface-strong);
        box-shadow: 0 24px 80px rgba(0, 0, 0, 0.46);
      }

      .support-close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        width: 2.25rem;
        height: 2.25rem;
        border: 1px solid var(--line);
        border-radius: 0.35rem;
        background: transparent;
        color: var(--muted);
        cursor: pointer;
        font-size: 1.5rem;
        line-height: 1;
      }

      .support-close:hover {
        border-color: var(--mint);
        color: var(--mint);
      }

      .support-eyebrow {
        margin: 0 0 0.65rem;
        color: var(--mint);
        font: 600 0.72rem 'JetBrains Mono', monospace;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .support-dialog h2 {
        max-width: 560px;
        padding-right: 2.5rem;
        font-size: clamp(2rem, 5vw, 3.5rem);
      }

      .support-dialog > p {
        max-width: 58ch;
        color: var(--muted);
      }

      .support-field {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.85rem 1rem;
        border: 1px solid var(--line);
        border-radius: 0.4rem;
        background: var(--ink-soft);
        color: var(--bone);
        font-family: 'JetBrains Mono', monospace;
        overflow-wrap: anywhere;
      }

      .support-copy {
        flex: 0 0 auto;
        border: 0;
        background: transparent;
        color: var(--mint);
        cursor: pointer;
        font: 600 0.82rem 'Hanken Grotesk', sans-serif;
      }

      .support-report-label {
        display: block;
        margin: 1.25rem 0 0.5rem;
        color: var(--muted);
        font: 0.72rem 'JetBrains Mono', monospace;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .support-report {
        width: 100%;
        min-height: 220px;
        resize: vertical;
        padding: 1rem;
        border: 1px solid var(--line);
        border-radius: 0.4rem;
        background: var(--ink-soft);
        color: var(--muted);
        font: 0.78rem/1.6 'JetBrains Mono', monospace;
      }

      .support-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.25rem;
      }

      @media (max-width: 1020px) {
        .desktop-nav {
          display: none;
        }

        .mobile-nav {
          display: block;
          position: relative;
        }

        .mobile-nav summary {
          cursor: pointer;
          color: var(--muted);
          font-weight: 700;
          list-style: none;
        }

        .mobile-nav summary::-webkit-details-marker {
          display: none;
        }

        .mobile-nav nav {
          position: absolute;
          right: 0;
          top: 2.2rem;
          display: grid;
          min-width: 190px;
          padding: 1rem;
          border: 1px solid var(--line-strong);
          background: var(--surface-strong);
        }

        .mobile-nav a {
          padding: 0.6rem;
        }

        .hero {
          min-height: 710px;
        }

        .hero-world {
          left: 0;
          width: 120%;
          object-position: 62% center;
          opacity: 0.66;
        }

        .hero-copy > * {
          width: min(680px, 84vw);
        }

        .layers,
        .proof,
        .faq {
          grid-template-columns: 1fr;
          gap: 3.5rem;
        }

        .faq-heading {
          position: static;
        }

        .layers-visual {
          max-width: 610px;
          margin-inline: auto;
        }

        .site-footer {
          grid-template-columns: 1fr;
          padding: 2.5rem 0;
          text-align: center;
        }

        .footer-brand,
        .site-footer nav {
          justify-content: center;
        }

        .site-footer p {
          text-align: center;
        }
      }

      @media (max-width: 720px) {
        .site-header,
        .site-footer,
        .band,
        .hero-copy {
          width: min(100% - 36px, 1376px);
        }

        .site-header {
          min-height: 72px;
        }

        .hero {
          min-height: auto;
        }

        .hero-world {
          top: -10px;
          left: 2%;
          width: 150%;
          height: 560px;
          object-position: 70% center;
          opacity: 0.46;
        }

        .hero-copy {
          padding: 72px 0 54px;
        }

        .hero-copy > * {
          width: 100%;
        }

        h1 {
          font-size: clamp(3rem, 14vw, 4.7rem);
          line-height: 0.95;
        }

        h2 {
          font-size: clamp(2.35rem, 11vw, 3.4rem);
        }

        .hero-lede {
          margin-top: 1.5rem;
        }

        .hero-actions,
        .paper-actions {
          align-items: stretch;
          flex-direction: column;
        }

        .button {
          width: 100%;
        }

        .command {
          align-items: flex-start;
          flex-direction: column;
        }

        .command code {
          overflow-wrap: anywhere;
        }

        .thesis,
        .section-heading {
          grid-template-columns: 1fr;
          gap: 1rem;
        }

        .layers-copy li {
          grid-template-columns: 1fr;
          gap: 0.6rem;
        }

        .adoption-flow {
          grid-template-columns: 1fr;
        }

        .adoption-flow li,
        .adoption-flow li:first-child {
          min-height: 0;
          padding: 2rem 0;
          border-right: 0;
          border-bottom: 1px solid var(--line);
        }

        .adoption-flow li:last-child {
          border-bottom: 0;
        }

        .step {
          margin-bottom: 1.4rem;
        }

        .adoption-actions,
        .proof-links {
          align-items: flex-start;
          flex-direction: column;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>
  </body>
</html>
