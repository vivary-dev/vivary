---
// Vivary — landing. Custom page (Starlight owns the /docs routes).
const repo = 'https://github.com/vivary-dev/vivary';
const layers = [
  { id: 'exo',    name: 'exo',    alt: 'exosphere',    role: 'Coordination and claims when one agent becomes many.', y: 0 },
  { id: 'ozone',  name: 'ozone',  alt: 'the filter',   role: 'Graph-aware review, by blast radius.',       y: 1 },
  { id: 'strato', name: 'strato', alt: 'stratosphere', role: 'The agent OS: loop, state, memory, gates.',  y: 2 },
  { id: 'tropo',  name: 'tropo',  alt: 'troposphere',  role: 'The typed knowledge graph. Ground truth.',   y: 3 },
];
const creates = [
  { t: 'Typed project memory', d: 'A validated knowledge graph, not a notes dump.', f: 'tropo.toml · changes/ · decisions/ · modules/' },
  { t: 'Visible state',        d: 'One surface the agent reads and updates.',        f: 'STATE.md' },
  { t: 'Reusable skills',      d: 'Runtime skills for Claude Code and Codex.',       f: '.claude/skills/ · .agents/skills/' },
  { t: 'Private boundaries',   d: 'Personal context and heartbeat reports stay out of Git.', f: 'USER.md · MEMORY.md · memory/ · heartbeat-reports/' },
  { t: 'Verification gates',   d: 'Human sign-off and graph checks before merge.',   f: 'gates/ · verification/ · tropo check' },
];
const releaseHighlights = [
  { t: 'Typed context packets', d: 'tropo find ranks the small set of graph nodes and files worth opening first, with reasons, snippets, and a token budget.' },
  { t: 'Filtered graph query', d: 'tropo query now searches typed graph nodes and supports type, path, edge, snippet, and explain filters.' },
  { t: 'Context-budget review', d: 'ozone review --pack context-budget flags oversized routing files, missing module indexes, duplicate routing blocks, and bulk-load cues.' },
  { t: 'Optional sidecars stay gated', d: 'LanceDB, CocoIndex-code, and Cognee remain explicit opt-ins; graph-first retrieval stays zero-dependency.' },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Vivary — typed memory, search, and gates for AI agents</title>
  <meta name="description" content="Vivary scaffolds the missing infrastructure for AI agents: typed project memory, search, visible state, reusable skills, and verification gates. One command from a human, zero prompts for an agent. Plain Markdown. Any agent. Live on PyPI and npm." />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <!-- Self-hosted fonts: no third-party request. Preload the latin variable subsets used above the fold. -->
  <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/hanken-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <div class="sky" aria-hidden="true"></div>
  <div class="stars" aria-hidden="true"></div>

  <header class="nav">
    <a class="brand" href="/">
      <svg width="26" height="26" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <rect width="32" height="32" rx="8" fill="url(#g)" />
        <path d="M6 22.5c3-2 7-2 10 0s7 2 10 0" stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity=".55" />
        <path d="M6 17c3-2 7-2 10 0s7 2 10 0" stroke="#fff" stroke-width="1.7" stroke-linecap="round" opacity=".78" />
        <path d="M6 11.5c3-2 7-2 10 0s7 2 10 0" stroke="#fff" stroke-width="1.8" stroke-linecap="round" />
        <circle cx="16" cy="8.5" r="1.7" fill="#fff" />
        <defs><linearGradient id="g" x1="0" y1="0" x2="32" y2="32"><stop stop-color="#1f9d72" /><stop offset="1" stop-color="#1b6fa8" /></linearGradient></defs>
      </svg>
      <span>Vivary</span>
    </a>
    <nav>
      <a href="/getting-started/">Docs</a>
      <a href="/blog/">Blog</a>
      <a href="/commands/">Reference</a>
      <a href={repo}>GitHub</a>
      <a class="pill" href="/getting-started/">Get started →</a>
    </nav>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero">
      <p class="kicker">Typed memory · search · gates — for AI-agent workspaces</p>
      <h1>The workspace your<br />agents can <span class="grad">navigate.</span></h1>
      <p class="lede">
        Vivary scaffolds the missing infrastructure for AI agents: typed project memory,
        graph search, visible state, reusable skills, and verification gates. One command
        from a human — or zero prompts from an agent. Plain Markdown. Any editor. Any agent.
      </p>
      <div class="cmd">
        <span class="p">$</span><span class="typed">npm create @vivary@latest my-workspace</span>
        <button class="copy" data-copy="npm create @vivary@latest my-workspace" aria-label="Copy">copy</button>
      </div>

      <!-- big central glowing graph: one node's blast radius lit -->
      <figure class="graphwrap" aria-label="A typed knowledge graph; changing the 'billing' node lights up everything that depends on it.">
        <svg viewBox="0 0 880 380" class="graph" role="img">
          <defs>
            <radialGradient id="glow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="oklch(0.84 0.16 168 / .5)" />
              <stop offset="100%" stop-color="oklch(0.84 0.16 168 / 0)" />
            </radialGradient>
          </defs>
          <circle class="halo" cx="440" cy="210" r="128" fill="url(#glow)" />
          <g class="edges" stroke-linecap="round" fill="none">
            <path d="M440 210 L250 86" />
            <path d="M440 210 L662 116" />
            <path d="M440 210 L724 262" />
            <path d="M440 210 L304 322" />
            <path class="hot" d="M440 210 L304 322" />
            <path class="hot" d="M440 210 L250 86" />
            <path class="hot" d="M250 86 L150 44" />
          </g>
          <g class="nodes">
            <g class="node hot src" transform="translate(440 210)"><circle r="13" /><text y="34">billing</text></g>
            <g class="node hot" transform="translate(304 322)"><circle r="8" /><text y="28">invoice</text></g>
            <g class="node hot" transform="translate(250 86)"><circle r="8" /><text y="-16">checkout</text></g>
            <g class="node hot" transform="translate(150 44)"><circle r="6.5" /><text y="-14">receipt</text></g>
            <g class="node" transform="translate(662 116)"><circle r="8" /><text y="-16">auth</text></g>
            <g class="node" transform="translate(724 262)"><circle r="8" /><text y="28">emails</text></g>
          </g>
        </svg>
        <figcaption><code>ozone impact billing</code> &nbsp;→&nbsp; 4 things depend on it. See it before you touch it.</figcaption>
      </figure>

      <ul class="strip" aria-label="Where to get Vivary">
        <a href="https://pypi.org/project/create-vivary/"><li><b>PyPI</b><span>create-vivary 0.2.8</span></li></a>
        <a href="https://pypi.org/project/vivary-tropo/"><li><b>PyPI</b><span>vivary-tropo 0.3.0</span></li></a>
        <a href="https://pypi.org/project/vivary-ozone/"><li><b>PyPI</b><span>vivary-ozone 0.2.0</span></li></a>
        <a href="https://pypi.org/project/vivary-exo/"><li><b>PyPI</b><span>vivary-exo 0.2.2</span></li></a>
        <a href="https://www.npmjs.com/package/@vivary/create"><li><b>npm</b><span>@vivary/create 0.2.8</span><img src="https://img.shields.io/npm/dm/%40vivary%2Fcreate?style=flat-square&color=84e7c0&label=" alt="monthly downloads" class="dl-badge" /></li></a>
        <a href={repo}><li><b>GitHub</b><span>public · MIT</span></li></a>
        <li><b>Runtime</b><span>Claude Code · Codex</span></li>
      </ul>
    </section>

    <!-- PITCH -->
    <section class="band pitch">
      <p>
        Every AI-agent project starts the same way: a pile of spec files, a
        <code>notes.md</code>, some &ldquo;rules,&rdquo; a memory dump. Then it rots.
        Vivary makes the workspace a <strong>known, structured, navigable thing</strong>,
        the way create-t3-app did for web stacks.
      </p>
      <blockquote>
        A self-improving loop running over a typed, navigable knowledge graph, with one
        visible state surface and human gates.
      </blockquote>
    </section>

    <!-- SIGNALS -->
    <section class="band signals">
      <div class="signals-copy">
        <p class="search-label">Public signals</p>
        <h2>Distribution, not vibes.</h2>
        <p>
          Vivary tracks npm, PyPI, and GitHub signals from public APIs through reviewed
          weekly PR snapshots. Early numbers are not a traction claim; they are a
          heartbeat that the package surfaces are live.
        </p>
        <a href="/signals/">How signals are tracked →</a>
      </div>
      <img src="/usage-snapshot.svg" alt="Vivary public usage snapshot chart" loading="lazy" />
    </section>

    <!-- WHAT IT CREATES -->
    <section class="band creates">
      <div class="creates-head">
        <h2>One command. Five things every agent project reinvents.</h2>
        <p><code>npm create @vivary@latest</code> lays down a complete, agent-native workspace, then
          <code>doctor</code> verifies it. Here's what lands, and the files that prove it on disk.</p>
      </div>
      <div class="creates-grid">
        <ol class="creates-list">
          {creates.map((c) => (
            <li><b>{c.t}</b><span>{c.d}</span><code>{c.f}</code></li>
          ))}
        </ol>
          <pre class="term"><span class="g">$ npm create @vivary@latest my-workspace</span>   <span class="dim"># preset: coding</span>
create-vivary: wrote 39 file(s) to my-workspace

<span class="g">$ create-vivary doctor my-workspace</span>
doctor: ok (9 node(s), 28 edge(s), 0 broken)

<span class="g">$ tropo check --root my-workspace</span>
tropo: 9 document(s), 0 error(s), 0 warning(s)  →  exit 0</pre>
      </div>
    </section>

    <!-- CONTEXT COMPRESSION -->
    <section class="band hardening">
      <div class="hardening-copy">
        <p class="search-label">Context compression</p>
        <h2>Open fewer files. Trust the ones you do open.</h2>
        <p>
          The current line adds typed context packets, graph-aware query filters,
          context-budget review, clearer active-context guidance, and an optional
          Cognee adapter path while keeping integrations behind explicit gates.
        </p>
      </div>
      <ul class="hardening-list">
        {releaseHighlights.map((item) => (
          <li><b>{item.t}</b><span>{item.d}</span></li>
        ))}
      </ul>
    </section>

    <!-- SEARCH + AGENT MODE -->
    <section class="band search">
      <div class="search-head">
        <h2>Your workspace knows<br />what it knows.</h2>
        <p><code>tropo find</code> returns a small packet of typed nodes to open first.
          <code>tropo query</code> gives power users graph-aware filters. Agents can scaffold
          and configure themselves with zero prompts, with explicit flags for storage and installs.</p>
      </div>
      <div class="search-grid">
        <div>
          <p class="search-label">Search the knowledge graph</p>
          <pre class="term"><span class="g">$ tropo find "where is release truth owned"</span>
  1  release-workflow  doc       reason: title/id + body
  2  changelog         doc       reason: path + body
  3  package-readme    doc       reason: body

<span class="g">$ tropo query "release truth" --type decision --explain</span>
<span class="dim">returns graph ids, types, paths, snippets, and match reasons</span></pre>
        </div>
        <div>
          <p class="search-label">Agents self-configure — no prompts</p>
          <pre class="term"><span class="g">$ create-vivary init . \
    --auto --size large \
    --yes --json</span>

<span class="dim">&#123;</span>
  <span class="acc">"ok"</span>: true,
  <span class="acc">"storage"</span>: <span class="g">"embedded"</span>,
  <span class="acc">"provider"</span>: <span class="g">"lancedb"</span>,
  <span class="acc">"installed"</span>: [<span class="g">"lancedb"</span>],
  <span class="acc">"files"</span>: 44
<span class="dim">&#125;</span></pre>
        </div>
      </div>
    </section>

    <!-- STRATA -->
    <section class="band strata">
      <div class="strata-head">
        <h2>Four layers,<br />named for the sky.</h2>
        <p>A <em>vivary</em> is a small self-contained world with stacked layers. The
          published CLIs are small Python tools; <code>strato</code> ships as bundled
          templates and skills. The baseline is the bottom two; the rest snap on when
          you need them.</p>
      </div>
      <ol class="column">
        {layers.map((l) => (
          <li class={`stratum s-${l.id}`} style={`--i:${l.y}`}>
            <span class="alt">{l.alt}</span>
            <span class="lname">{l.name}</span>
            <span class="lrole">{l.role}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- WHY -->
    <section class="band why">
      <h2>Not just a folder of Markdown.</h2>
      <div class="rows">
        <div class="row">
          <div class="rtext">
            <h3>The graph is validated, opinionated.</h3>
            <p><code>tropo check</code> is a gate, not a linter. Untyped docs, typo'd fields,
              and broken links <em>fail</em>. Your agent's context stays trustworthy instead
              of quietly rotting.</p>
          </div>
          <pre class="term"><span class="g">$ tropo check</span>
changes/billing.md:3 error E101: missing required field 'status'
modules/auth.md:5 warning W220: ref 'sessoin' matches no document id
<span class="r">tropo: 12 document(s), 1 error(s), 1 warning(s)  →  exit 1</span></pre>
        </div>

        <div class="row reverse">
          <div class="rtext">
            <h3>Review by blast radius.</h3>
            <p>See what a change <em>touches</em>, not just what lines changed.
              <code>ozone review</code> reads the whole graph; <code>impact</code> walks the
              dependents. The thing a text diff can't show.</p>
          </div>
          <pre class="term"><span class="g">$ ozone impact billing</span>
billing  →  4 node(s) depend on it
  1  invoice    (change, via related_changes)
  1  checkout   (module,  via related_modules)
  2  receipt    (change,  via related_changes)</pre>
        </div>
      </div>

      <ul class="trio">
        <li><b>Medium-agnostic.</b> The same graph and review serve code <em>and</em> prose.</li>
        <li><b>No lock-in.</b> Plain Markdown, any editor or none, Claude Code <em>and</em> Codex.</li>
        <li><b>Tiny by law.</b> No third-party dependencies, <code>tropo</code> runs on the standard library.</li>
      </ul>
    </section>

    <!-- CLOSER -->
    <section class="band closer">
      <h2>Start in one command.</h2>
      <pre class="term big"><span class="g">$ npm create @vivary@latest my-workspace</span>   <span class="dim"># wizard picks your storage tier</span>
<span class="g">$ pip install vivary-tropo vivary-ozone vivary-exo create-vivary==0.2.8</span>
<span class="g">$ tropo query "what changed last sprint"</span>   <span class="dim"># search the graph</span>
<span class="g">$ create-vivary init . --auto --yes --json</span>   <span class="dim"># agent-mode: zero prompts</span></pre>
      <div class="cta">
        <a class="btn primary" href="/getting-started/">Read the docs</a>
        <a class="btn" href={repo}>GitHub</a>
      </div>
    </section>
  </main>

  <footer class="foot">
    <span>Vivary · MIT · published on PyPI &amp; npm</span>
    <nav>
      <a href="/getting-started/">Docs</a>
      <a href="/blog/">Blog</a>
      <a href={repo}>GitHub</a>
      <a href="https://pypi.org/project/vivary-tropo/">PyPI</a>
      <a href="https://www.npmjs.com/package/@vivary/create">npm</a>
    </nav>
  </footer>

  <script is:inline>
    document.querySelectorAll('.copy').forEach((b) => {
      b.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(b.dataset.copy); b.textContent = 'copied'; setTimeout(() => (b.textContent = 'copy'), 1400); } catch (e) {}
      });
    });
  </script>

  <style is:global>
    /* Self-hosted variable fonts (latin subset). font-display: swap keeps text visible instantly. */
    @font-face { font-family: 'Bricolage Grotesque'; font-style: normal; font-weight: 400 800; font-display: swap; src: url('/fonts/bricolage-grotesque-latin.woff2') format('woff2'); }
    @font-face { font-family: 'Hanken Grotesk'; font-style: normal; font-weight: 400 600; font-display: swap; src: url('/fonts/hanken-grotesk-latin.woff2') format('woff2'); }
    @font-face { font-family: 'JetBrains Mono'; font-style: normal; font-weight: 400 500; font-display: swap; src: url('/fonts/jetbrains-mono-latin.woff2') format('woff2'); }

    :root {
      --ink: oklch(0.97 0.012 165);
      --muted: oklch(0.75 0.03 180);
      --faint: oklch(0.62 0.025 185);
      --accent: oklch(0.84 0.16 168);
      --accent-2: oklch(0.74 0.13 240);
      --panel: oklch(0.26 0.03 200 / 0.45);
      --line: oklch(0.7 0.04 185 / 0.16);
      --line-strong: oklch(0.8 0.08 175 / 0.32);
      --serif: 'Bricolage Grotesque', system-ui, sans-serif;
      --sans: 'Hanken Grotesk', system-ui, sans-serif;
      --mono: 'JetBrains Mono', ui-monospace, monospace;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; background: oklch(0.13 0.045 280); }
    body {
      margin: 0; color: var(--ink); font-family: var(--sans);
      font-size: clamp(15px, 1vw + 13px, 18px); line-height: 1.65; min-height: 100vh; overflow-x: hidden;
      background: linear-gradient(180deg, oklch(0.13 0.045 280) 0%, oklch(0.155 0.05 240) 38%, oklch(0.185 0.055 198) 70%, oklch(0.225 0.06 166) 100%);
      background-attachment: fixed;
    }
    .sky {
      position: fixed; inset: -30% -10% auto -10%; height: 95vh; z-index: 0; pointer-events: none;
      background:
        radial-gradient(58% 50% at 72% 0%, oklch(0.84 0.16 168 / .2), transparent 70%),
        radial-gradient(50% 44% at 14% 16%, oklch(0.7 0.14 250 / .15), transparent 72%);
      filter: blur(10px);
    }
    .stars {
      position: fixed; inset: 0; z-index: 0; pointer-events: none; opacity: .5;
      background-image:
        radial-gradient(1.2px 1.2px at 20% 22%, #fff, transparent),
        radial-gradient(1px 1px at 70% 12%, #fff, transparent),
        radial-gradient(1px 1px at 45% 9%, #fff, transparent),
        radial-gradient(1.4px 1.4px at 85% 30%, #fff, transparent),
        radial-gradient(1px 1px at 32% 6%, #fff, transparent),
        radial-gradient(1.1px 1.1px at 58% 26%, #fff, transparent);
      background-repeat: no-repeat;
    }
    main, .nav, .foot { position: relative; z-index: 1; }
    a { color: inherit; text-decoration: none; }
    code { font-family: var(--mono); font-size: 0.88em; color: var(--accent); }
    strong, b { color: var(--ink); font-weight: 600; }
    em { font-style: normal; color: var(--accent); }

    /* nav */
    .nav { display: flex; align-items: center; justify-content: space-between;
      max-width: 1200px; width: 100%; margin: 0 auto; padding: 22px clamp(20px, 5vw, 44px); gap: 18px; }
    .brand { display: flex; align-items: center; gap: 10px; font-family: var(--serif);
      font-weight: 700; font-size: 19px; letter-spacing: -0.01em; flex: 0 0 auto; }
    .nav nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px clamp(14px, 2.6vw, 28px); align-items: center; min-width: 0; font-size: 15px; color: var(--muted); }
    .nav nav a:hover { color: var(--ink); }
    .nav .pill { color: var(--ink); border: 1px solid var(--line-strong); border-radius: 999px; padding: 8px 16px; transition: border-color .2s, background .2s; }
    .nav .pill:hover { border-color: var(--accent); background: oklch(0.84 0.16 168 / 0.12); }

    main { max-width: 1200px; margin: 0 auto; padding: 0 clamp(20px, 5vw, 44px); }
    main > *, .signals > *, .hardening > *, .creates-grid > *, .search-grid > *, .strata > *, .row > * { min-width: 0; }

    /* hero */
    .hero { text-align: center; padding: clamp(34px, 6vw, 76px) 0 clamp(40px, 6vw, 80px); }
    .kicker { font-family: var(--mono); font-size: 13.5px; letter-spacing: 0.04em; color: var(--accent); margin: 0 0 26px; }
    h1 { font-family: var(--serif); font-weight: 800; letter-spacing: -0.035em; line-height: 0.9;
      font-size: clamp(46px, 9.4vw, 132px); margin: 0 auto; max-width: 10ch; color: var(--ink); }
    .grad { color: var(--accent); }
    .lede { max-width: 54ch; color: var(--muted); font-size: clamp(16px, 1.3vw, 21px); margin: 30px auto 30px; line-height: 1.5; }
    .cmd { display: inline-flex; align-items: center; gap: 12px; font-family: var(--mono); font-size: 15px;
      background: var(--panel); border: 1px solid var(--line); border-radius: 13px;
      padding: 14px 16px; backdrop-filter: blur(8px); max-width: 100%; }
    .cmd .p { color: var(--accent); flex: 0 0 auto; } .cmd .typed { color: var(--ink); min-width: 0; overflow-wrap: anywhere; }
    .copy { font-family: var(--mono); font-size: 12px; color: var(--faint); background: none;
      border: 1px solid var(--line); border-radius: 7px; padding: 4px 9px; cursor: pointer; transition: color .2s, border-color .2s; }
    .copy:hover { color: var(--accent); border-color: var(--line-strong); }

    /* hero graph */
    .graphwrap { margin: clamp(28px, 5vw, 56px) 0 0; }
    .graph { width: 100%; max-width: 880px; height: auto; display: block; margin-inline: auto; }
    .graph .halo { animation: pulse 3.6s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
    .graph .edges path { stroke: var(--line-strong); stroke-width: 1.5;
      stroke-dasharray: 360; stroke-dashoffset: 360; animation: draw 1.5s cubic-bezier(.2,.8,.2,1) forwards; }
    .graph .edges .hot { stroke: var(--accent); stroke-width: 2; }
    .graph .node circle { fill: oklch(0.5 0.04 200); stroke: oklch(0.8 0.05 190 / .5); stroke-width: 1; }
    .graph .node.hot circle { fill: var(--accent); stroke: oklch(0.9 0.12 168); filter: drop-shadow(0 0 8px oklch(0.84 0.16 168 / .7)); }
    .graph .node.src circle { fill: oklch(0.92 0.14 168); }
    .graph .node text { fill: var(--muted); font-family: var(--mono); font-size: 12.5px; text-anchor: middle; }
    .graph .node.hot text { fill: var(--ink); }
    figcaption { text-align: center; color: var(--faint); font-size: 14px; margin: 16px auto 0; max-width: 100%; overflow-wrap: anywhere; }
    figcaption code { color: var(--accent); }

    .strip { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin: 50px 0 0; padding: 0; }
    .strip a { display: block; }
    .strip li { display: flex; flex-direction: column; gap: 1px; padding: 9px 16px; border-radius: 12px;
      border: 1px solid var(--line); background: var(--panel); backdrop-filter: blur(6px); transition: border-color .2s, transform .2s; }
    .strip a:hover li { border-color: var(--accent); transform: translateY(-2px); }
    .strip b { font-family: var(--serif); font-size: 14px; color: var(--ink); }
    .strip span { font-family: var(--mono); font-size: 11.5px; color: var(--faint); }

    /* bands */
    .band { padding: clamp(54px, 8vw, 104px) 0; border-top: 1px solid var(--line); }
    .pitch p { font-size: clamp(20px, 1.9vw, 28px); max-width: 46ch; line-height: 1.5; color: var(--ink); margin: 0 auto 26px; text-align: center; }
    .pitch blockquote { margin: 0 auto; padding-top: 4px; max-width: 44ch; text-align: center;
      font-family: var(--serif); font-size: clamp(17px, 1.5vw, 22px); color: var(--accent); line-height: 1.4; }

    /* signals */
    .signals { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(22px, 4vw, 52px); align-items: center; }
    .signals h2 { font-family: var(--serif); font-size: clamp(28px, 3.5vw, 46px); letter-spacing: -0.025em; line-height: 1.03; margin: 0 0 14px; }
    .signals p:not(.search-label) { color: var(--muted); margin: 0 0 16px; max-width: 38ch; }
    .signals a { color: var(--accent); font-weight: 600; }
    .signals img { display: block; width: 100%; height: auto; border-radius: 16px; border: 1px solid var(--line); background: oklch(0.13 0.035 220 / .66); }

    /* hardening */
    .hardening { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(22px, 4vw, 52px); align-items: start; }
    .hardening h2 { font-family: var(--serif); font-size: clamp(28px, 3.8vw, 50px); letter-spacing: -0.025em; line-height: 1.03; margin: 0 0 14px; }
    .hardening p:not(.search-label) { color: var(--muted); margin: 0; max-width: 39ch; }
    .hardening-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
    .hardening-list li { display: grid; gap: 4px; padding: 18px 20px; border-radius: 14px; border: 1px solid var(--line); background: var(--panel); }
    .hardening-list b { font-family: var(--serif); font-size: 18px; color: var(--ink); }
    .hardening-list span { color: var(--muted); font-size: 15px; }

    /* creates */
    .creates-head { text-align: center; }
    .creates-head h2 { font-family: var(--serif); font-size: clamp(28px, 4vw, 52px); letter-spacing: -0.025em; line-height: 1.04; margin: 0 auto 14px; max-width: 20ch; }
    .creates-head p { color: var(--muted); max-width: 56ch; margin: 0 auto 44px; }
    .creates-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 48px); align-items: start; }
    .creates-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; counter-reset: c; }
    .creates-list li { display: grid; grid-template-columns: auto 1fr; column-gap: 14px; row-gap: 2px;
      padding: 16px 18px; border-radius: 14px; border: 1px solid var(--line); background: var(--panel); }
    .creates-list li::before { counter-increment: c; content: counter(c); grid-row: 1 / span 3; align-self: start;
      font-family: var(--mono); font-size: 12px; color: oklch(0.2 0.05 168); background: var(--accent);
      width: 23px; height: 23px; border-radius: 7px; display: grid; place-items: center; font-weight: 600; }
    .creates-list b { font-family: var(--serif); font-size: 17px; color: var(--ink); }
    .creates-list span { color: var(--muted); font-size: 14.5px; }
    .creates-list code { grid-column: 2; font-size: 12px; color: var(--accent); display: block; margin-top: 3px; }
    .creates-grid .term { position: sticky; top: 24px; }

    /* strata */
    .strata { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
    .strata-head h2 { font-family: var(--serif); font-size: clamp(30px, 4vw, 52px); letter-spacing: -0.025em; line-height: 1; margin: 0 0 16px; }
    .strata-head p { color: var(--muted); max-width: 34ch; margin: 0; }
    .strata-head em { font-style: italic; color: var(--ink); }
    .column { list-style: none; margin: 0; padding: 0; position: relative; display: grid; gap: 10px; }
    .stratum { display: grid; grid-template-columns: auto 1fr; column-gap: 16px; align-items: baseline;
      padding: 18px 22px; border-radius: 14px; border: 1px solid var(--line);
      background: linear-gradient(100deg, var(--lc, oklch(0.3 0.05 200 / .4)), transparent 92%);
      opacity: 0; transform: translateY(12px); animation: rise .6s cubic-bezier(.2,.8,.2,1) forwards; animation-delay: calc(var(--i) * 90ms); }
    .s-exo    { --lc: oklch(0.42 0.1 264 / .5); }
    .s-ozone  { --lc: oklch(0.5 0.1 212 / .5); }
    .s-strato { --lc: oklch(0.53 0.1 182 / .5); }
    .s-tropo  { --lc: oklch(0.52 0.12 162 / .55); }
    .alt { font-family: var(--mono); font-size: 11.5px; color: var(--faint); grid-row: 2; }
    .lname { font-family: var(--serif); font-weight: 700; font-size: 23px; letter-spacing: -0.01em; }
    .lrole { grid-column: 2; color: var(--muted); font-size: 15px; }

    /* why */
    .why h2, .closer h2 { font-family: var(--serif); font-size: clamp(30px, 4.2vw, 54px); letter-spacing: -0.025em; margin: 0 0 40px; text-align: center; }
    .rows { display: grid; gap: clamp(28px, 4vw, 52px); }
    .row { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(20px, 4vw, 48px); align-items: center; }
    .row.reverse { grid-template-columns: 1.1fr 0.9fr; }
    .row.reverse .rtext { order: 2; }
    .rtext h3 { font-family: var(--serif); font-size: clamp(21px, 1.9vw, 28px); margin: 0 0 10px; letter-spacing: -0.01em; }
    .rtext p { color: var(--muted); margin: 0; max-width: 40ch; }
    .term { font-family: var(--mono); font-size: 13px; line-height: 1.75; color: var(--muted); max-width: 100%;
      background: oklch(0.13 0.035 220 / .66); border: 1px solid var(--line); border-radius: 14px;
      padding: 18px 20px; overflow-x: auto; margin: 0; backdrop-filter: blur(6px); }
    .term .g { color: var(--accent); } .term .r { color: oklch(0.78 0.15 30); } .term .dim { color: var(--faint); }
    .term.big { font-size: 14px; max-width: 44rem; margin: 0 auto 30px; }
    .trio { list-style: none; margin: 48px 0 0; padding: 36px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 22px 36px; border-top: 1px solid var(--line); }
    .trio li { color: var(--muted); font-size: 15.5px; } .trio b { display: block; color: var(--ink); font-family: var(--serif); font-size: 17px; margin-bottom: 3px; }

    /* closer + footer */
    .closer { text-align: center; }
    .cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .btn { font-weight: 600; font-size: 15px; padding: 12px 22px; border-radius: 11px;
      border: 1px solid var(--line-strong); color: var(--ink); transition: transform .2s cubic-bezier(.2,.8,.2,1), background .2s, border-color .2s; }
    .btn:hover { transform: translateY(-2px); border-color: var(--accent); }
    .btn.primary { background: var(--accent); color: oklch(0.2 0.05 168); border-color: transparent; }
    .btn.primary:hover { background: oklch(0.88 0.16 168); }
    .foot { max-width: 1200px; margin: 0 auto; padding: 30px clamp(20px, 5vw, 44px) 60px;
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;
      border-top: 1px solid var(--line); font-family: var(--mono); font-size: 13px; color: var(--faint); }
    .foot nav { display: flex; gap: 22px; } .foot a:hover { color: var(--accent); }

    /* dl-badge: shields.io inline in strip */
    .strip .dl-badge { display: block; height: 16px; margin-top: 3px; }

    /* search section */
    .search-head { text-align: center; margin-bottom: clamp(28px, 4vw, 48px); }
    .search-head h2 { font-family: var(--serif); font-size: clamp(30px, 4.2vw, 54px); letter-spacing: -0.025em; margin: 0 0 16px; }
    .search-head p { color: var(--muted); max-width: 50ch; margin: 0 auto; }
    .search-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(18px, 3vw, 40px); }
    .search-label { font-family: var(--mono); font-size: 12px; color: var(--faint); letter-spacing: 0.05em; text-transform: uppercase; margin: 0 0 10px; }
    .term .acc { color: oklch(0.78 0.12 240); }
    @media (max-width: 640px) { .search-grid { grid-template-columns: 1fr; } }

    @keyframes draw { to { stroke-dashoffset: 0; } }
    @keyframes rise { to { opacity: 1; transform: none; } }
    @keyframes pulse { 0%,100% { opacity: .5; } 50% { opacity: 1; } }

    @media (max-width: 880px) {
      .strata, .row, .row.reverse, .creates-grid, .signals, .hardening { grid-template-columns: 1fr; }
      .creates-grid .term { position: static; }
      .row.reverse .rtext { order: 0; }
      h1 { font-size: 72px; }
    }
    @media (max-width: 640px) {
      .nav { align-items: flex-start; flex-direction: column; padding: 18px 24px; }
      .nav nav { justify-content: flex-start; width: 100%; gap: 8px 14px; font-size: 14px; }
      .nav .pill { padding: 6px 12px; }
      main { padding-inline: 24px; }
      .hero { padding-top: 42px; }
      .kicker { max-width: 30ch; margin-inline: auto; }
      h1 { font-size: 48px; line-height: 0.96; letter-spacing: 0; max-width: 8ch; }
      .lede { font-size: 16px; margin-top: 24px; }
      .cmd { display: grid; grid-template-columns: auto minmax(0, 1fr); width: 100%; padding: 14px; text-align: left; }
      .copy { grid-column: 2; justify-self: start; margin-top: 2px; }
      .strip { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
      .strip a, .strip > li { min-width: 0; }
      .strip li { height: 100%; padding-inline: 12px; }
      .strip span { overflow-wrap: anywhere; }
      .term { font-size: 12px; padding: 16px; }
      .term.big { font-size: 12px; }
    }
    @media (max-width: 420px) {
      main { padding-inline: 20px; }
      .nav { padding-inline: 20px; }
      h1 { font-size: 44px; }
      .cmd { font-size: 13px; }
      .copy { padding-inline: 8px; }
      .strip { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, .graph .edges path, .stratum, .graph .halo { animation: none !important; opacity: 1 !important; transform: none !important; stroke-dashoffset: 0 !important; }
      html { scroll-behavior: auto; }
    }
  </style>
</body>
</html>
