---
import { getCollection } from 'astro:content';
const repo = 'https://github.com/vivary-dev/vivary';
const posts = (await getCollection('blog'))
  .filter((p) => import.meta.env.PROD ? !p.data.draft : true)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Vivary — Blog</title>
  <meta name="description" content="Field notes on agent-native workspaces: why Vivary exists, what it's for, how to run it (including with local models), and what we're learning about agent harnesses." />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/hanken-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <div class="sky" aria-hidden="true"></div>
  <div class="stars" aria-hidden="true"></div>

  <header class="nav">
    <a class="brand" href="/">
      <img src="/media/vivary-mark.png" alt="" width="26" height="26" />
      <span>Vivary</span>
    </a>
    <nav>
      <a href="/getting-started/">Docs</a>
      <a href="/learn/">Learn</a>
      <a href="/blog/" class="here">Blog</a>
      <a href={repo}>GitHub</a>
      <a class="pill" href="/getting-started/">Get started →</a>
    </nav>
  </header>

  <main>
    <header class="head">
      <p class="kicker">Field notes</p>
      <h1>The Vivary blog.</h1>
      <p class="lede">Why this exists, what it's for, and what we're learning about agent
        harnesses, agent-native workspaces, and running it all locally.</p>
    </header>

    <ol class="posts">
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.id}/`}>
            <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
            <div class="meta">
              {p.data.tags.map((t) => <span class="tag">{t}</span>)}
              <span class="read">Read →</span>
            </div>
          </a>
        </li>
      ))}
    </ol>

    {posts.length === 0 && <p class="empty">No posts yet. Check back soon.</p>}
  </main>

  <footer class="foot">
    <span>Vivary · MIT · published on PyPI &amp; npm</span>
    <nav>
      <a href="/getting-started/">Docs</a>
      <a href="/learn/">Learn</a>
      <a href="/blog/">Blog</a>
      <a href={repo}>GitHub</a>
    </nav>
  </footer>

  <style is:global>
    @font-face { font-family: 'Bricolage Grotesque'; font-weight: 400 800; font-display: swap; src: url('/fonts/bricolage-grotesque-latin.woff2') format('woff2'); }
    @font-face { font-family: 'Hanken Grotesk'; font-weight: 400 600; font-display: swap; src: url('/fonts/hanken-grotesk-latin.woff2') format('woff2'); }
    @font-face { font-family: 'JetBrains Mono'; font-weight: 400 500; font-display: swap; src: url('/fonts/jetbrains-mono-latin.woff2') format('woff2'); }
    :root {
      --ink: oklch(0.97 0.012 165); --muted: oklch(0.75 0.03 180); --faint: oklch(0.62 0.025 185);
      --accent: oklch(0.84 0.16 168); --panel: oklch(0.26 0.03 200 / 0.45);
      --line: oklch(0.7 0.04 185 / 0.16); --line-strong: oklch(0.8 0.08 175 / 0.32);
      --serif: 'Bricolage Grotesque', system-ui, sans-serif; --sans: 'Hanken Grotesk', system-ui, sans-serif; --mono: 'JetBrains Mono', ui-monospace, monospace;
    }
    * { box-sizing: border-box; }
    html { background: oklch(0.13 0.045 280); scroll-behavior: smooth; }
    body { margin: 0; color: var(--ink); font-family: var(--sans); font-size: clamp(15px,1vw + 13px,18px); line-height: 1.65;
      min-height: 100vh; overflow-x: hidden;
      background: linear-gradient(180deg, oklch(0.13 0.045 280) 0%, oklch(0.155 0.05 240) 40%, oklch(0.2 0.057 184) 100%); background-attachment: fixed; }
    .sky { position: fixed; inset: -30% -10% auto -10%; height: 95vh; z-index: 0; pointer-events: none;
      background: radial-gradient(58% 50% at 72% 0%, oklch(0.84 0.16 168 / .18), transparent 70%), radial-gradient(50% 44% at 14% 16%, oklch(0.7 0.14 250 / .14), transparent 72%); filter: blur(10px); }
    .stars { position: fixed; inset: 0; z-index: 0; pointer-events: none; opacity: .5;
      background-image: radial-gradient(1.2px 1.2px at 20% 22%, #fff, transparent), radial-gradient(1px 1px at 70% 12%, #fff, transparent), radial-gradient(1.4px 1.4px at 85% 30%, #fff, transparent), radial-gradient(1px 1px at 32% 6%, #fff, transparent); background-repeat: no-repeat; }
    main, .nav, .foot { position: relative; z-index: 1; }
    a { color: inherit; text-decoration: none; }

    .nav { display: flex; align-items: center; justify-content: space-between; max-width: 1100px; margin: 0 auto; padding: 22px clamp(20px,5vw,44px); }
    .brand { display: flex; align-items: center; gap: 10px; font-family: var(--serif); font-weight: 700; font-size: 19px; }
    .brand img { object-fit: contain; }
    .nav nav { display: flex; gap: clamp(14px,2.6vw,28px); align-items: center; font-size: 15px; color: var(--muted); }
    .nav nav a:hover, .nav .here { color: var(--ink); }
    .nav .pill { color: var(--ink); border: 1px solid var(--line-strong); border-radius: 999px; padding: 8px 16px; transition: border-color .2s, background .2s; }
    .nav .pill:hover { border-color: var(--accent); background: oklch(0.84 0.16 168 / .12); }

    main { max-width: 1100px; margin: 0 auto; padding: 0 clamp(20px,5vw,44px); }
    .head { padding: clamp(40px,6vw,84px) 0 clamp(28px,4vw,48px); border-bottom: 1px solid var(--line); }
    .kicker { font-family: var(--mono); font-size: 13px; letter-spacing: .04em; color: var(--accent); margin: 0 0 18px; }
    .head h1 { font-family: var(--serif); font-weight: 800; letter-spacing: -0.03em; font-size: clamp(44px,7vw,84px); line-height: 0.94; margin: 0; }
    .head .lede { color: var(--muted); max-width: 56ch; font-size: clamp(16px,1.2vw,20px); margin: 22px 0 0; }

    .posts { list-style: none; margin: 0; padding: 0; }
    .posts li { border-bottom: 1px solid var(--line); }
    .posts a { display: block; padding: clamp(26px,3.4vw,40px) 0; transition: padding-left .25s cubic-bezier(.2,.8,.2,1); }
    .posts a:hover { padding-left: 12px; }
    .posts time { font-family: var(--mono); font-size: 12.5px; color: var(--faint); }
    .posts h2 { font-family: var(--serif); font-weight: 700; letter-spacing: -0.02em; font-size: clamp(24px,2.8vw,38px); line-height: 1.05; margin: 10px 0 10px; max-width: 24ch; }
    .posts a:hover h2 { color: var(--accent); }
    .posts p { color: var(--muted); margin: 0; max-width: 64ch; }
    .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 16px; }
    .tag { font-family: var(--mono); font-size: 11.5px; color: var(--faint); border: 1px solid var(--line); border-radius: 999px; padding: 3px 11px; }
    .read { font-family: var(--mono); font-size: 12.5px; color: var(--accent); margin-left: auto; }
    .empty { color: var(--muted); padding: 60px 0; }

    .foot { max-width: 1100px; margin: 60px auto 0; padding: 30px clamp(20px,5vw,44px) 60px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; border-top: 1px solid var(--line); font-family: var(--mono); font-size: 13px; color: var(--faint); }
    .foot nav { display: flex; gap: 22px; } .foot a:hover { color: var(--accent); }

    @media (max-width: 640px) { .read { margin-left: 0; } }
  </style>
</body>
</html>
